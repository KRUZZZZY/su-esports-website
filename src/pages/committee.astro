---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommitteeCard from "../components/CommitteeCard.astro";
import ProfileModal from "../components/ProfileModal.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const committee = (await getCollection("committee")).sort((a, b) => a.data.order - b.data.order);
const reps = (await getCollection("reps")).sort((a, b) => a.data.game.localeCompare(b.data.game));
---

<BaseLayout title="Committee">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl tracking-wide text-offwhite">Committee</h1>
    <p class="mt-2 max-w-2xl text-offwhite/60">
      The people who run the society. Reach us by email at{" "}
      <a href={`mailto:${site.email}`} class="text-brand hover:underline">{site.email}</a>{" "}
      or through the <a href={site.discord} target="_blank" rel="noopener" class="text-brand hover:underline">Discord</a>.
    </p>

    <h2 class="mt-10 font-display text-2xl tracking-wide text-brand">Committee 2026/27</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {committee.map((m) => (
        <CommitteeCard name={m.data.name} role={m.data.role} ign={m.data.ign} photo={m.data.photo} bio={m.data.bio} socials={m.data.socials} />
      ))}
    </div>

    <h2 class="mt-12 font-display text-2xl tracking-wide text-brand">Game Reps 2026/27</h2>
    <div class="mt-4 grid gap-x-8 gap-y-0 sm:grid-cols-2">
      {reps.map((r) => (
        <button
          type="button"
          aria-haspopup="dialog"
          data-profile={JSON.stringify({ name: r.data.name, role: r.data.game, ign: r.data.ign, photo: r.data.photo, bio: r.data.bio })}
          class="flex w-full cursor-pointer items-baseline justify-between gap-3 border-b border-line/15 bg-transparent py-2.5 text-left font-inherit transition-colors hover:border-line/30 hover:bg-line/[0.03] focus-visible:outline-2 focus-visible:outline-brand"
        >
          <span class="font-medium text-offwhite">{r.data.game}</span>
          <span class="text-right text-offwhite/60">{r.data.name}{r.data.ign ? ` “${r.data.ign}”` : ""}</span>
        </button>
      ))}
    </div>
  </section>

  <ProfileModal />
</BaseLayout>

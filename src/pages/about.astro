---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../site.config";
---

<BaseLayout title="About">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl tracking-wide text-offwhite">About us</h1>
    <div class="mt-6 space-y-4 text-offwhite/80">
      <p>
        {site.name} is the home of competitive and casual gaming at Swansea University. We field teams across a
        range of titles, run tournaments and socials year-round, and welcome players of every skill level.
      </p>
      <p>
        We compete in the national university leagues — <a href={site.competitions[0].href} target="_blank" rel="noopener" class="text-brand hover:underline">NUEL</a>{" "}
        and <a href={site.competitions[1].href} target="_blank" rel="noopener" class="text-brand hover:underline">NSE</a> — and the community lives on Discord.
      </p>
      <p>
        We're a society of the{" "}
        <a href={site.studentsUnion} target="_blank" rel="noopener" class="text-brand hover:underline">Swansea University Students' Union</a>.
      </p>
    </div>

    <h2 class="mt-10 font-display text-2xl tracking-wide text-brand">Follow us</h2>
    <div class="mt-4">
      <SocialLinks />
    </div>

    <img src="/brand/logo-crest.png" alt="Swansea Esports crest" width="678" height="800" class="mx-auto mt-12 h-64 w-auto opacity-90" />
  </section>
</BaseLayout>

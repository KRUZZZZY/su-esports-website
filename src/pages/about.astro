---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../site.config";
---

<BaseLayout title="About">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl tracking-wide text-offwhite">About us</h1>
    <div class="mt-6 space-y-4 text-offwhite/80">
      <p>
        Swansea Esports is open to every Swansea student, from casual players to competitive regulars.
        You don't need trials experience or a trophy cabinet to get involved.
      </p>
      <p>
        Our team trials run in late September and October ahead of the winter season, with more chances
        to join through the year if you miss them.
      </p>
    </div>

    <h2 class="mt-10 font-display text-2xl tracking-wide text-brand">Games we play</h2>
    <p class="mt-4 text-offwhite/80">
      We field competitive teams in Valorant, League of Legends, Overwatch 2, Counter-Strike 2,
      Rainbow Six Siege, Rocket League and Apex Legends. Our Game Reps also run Teamfight Tactics,
      fighting games and casual in-houses, so there's usually something on whatever you play.
    </p>

    <h2 class="mt-10 font-display text-2xl tracking-wide text-brand">Our events</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-offwhite/80">
      <li>24 Hour LAN events in collaboration with the Swansea Gaming Society (SGS)</li>
      <li>Esports tournaments (National University Esports League, National Students Esports, Belong Arena Clash, &amp; ESL)</li>
      <li>Viewing parties for big gaming events (such as E3)</li>
      <li>Inhouses organised by Game Reps</li>
      <li>Potential trips to student tournaments across the UK</li>
    </ul>

    <h2 class="mt-10 font-display text-2xl tracking-wide text-brand">Contact us</h2>
    <div class="mt-4 space-y-3 text-offwhite/80">
      <p>
        Email the committee at{" "}
        <a href={`mailto:${site.email}`} class="text-brand hover:underline">{site.email}</a>.
      </p>
      <p>
        For the fastest reply,{" "}
        <a href={site.discord} target="_blank" rel="noopener" class="text-brand hover:underline">join the Discord</a>{" "}
        and message a committee member directly.
      </p>
    </div>

    <h2 class="mt-10 font-display text-2xl tracking-wide text-brand">Follow us</h2>
    <div class="mt-4">
      <SocialLinks />
    </div>

    <div class="mx-auto mt-12 flex h-72 w-72 items-center justify-center rounded-full bg-black">
      <img src="/brand/logo-crest.png" alt="Swansea Esports crest" width="678" height="800" class="h-56 w-auto opacity-90" />
    </div>
  </section>
</BaseLayout>

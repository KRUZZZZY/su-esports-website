---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import DiscordIcon from "../components/DiscordIcon.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const placements = await getCollection("placements");
const totalPlacements = placements.length;

const schedule = [
  {
    day: "Monday",
    games: [
      { name: "Splatoon", chip: "border-pink-400/40", dot: "bg-pink-400" },
      { name: "Teamfight Tactics", chip: "border-violet-400/40", dot: "bg-violet-400" },
      { name: "Valorant", chip: "border-red-400/40", dot: "bg-red-400" },
    ],
  },
  {
    day: "Tuesday",
    games: [
      { name: "League of Legends", chip: "border-amber-400/40", dot: "bg-amber-400" },
      { name: "Marvel Rivals", chip: "border-indigo-400/40", dot: "bg-indigo-400" },
      { name: "Rocket League", chip: "border-blue-400/40", dot: "bg-blue-400" },
    ],
  },
  {
    day: "Thursday",
    games: [
      { name: "Apex Legends", chip: "border-rose-400/40", dot: "bg-rose-400" },
      { name: "Overwatch 2", chip: "border-orange-400/40", dot: "bg-orange-400" },
      { name: "Rainbow Six Siege", chip: "border-sky-400/40", dot: "bg-sky-400" },
    ],
  },
  {
    day: "Sunday",
    games: [{ name: "Counter-Strike 2", chip: "border-yellow-400/40", dot: "bg-yellow-400" }],
  },
];

const steps = [
  {
    n: "01",
    title: "Join the Discord",
    body: "The whole community lives there. Get verified, find your game and hear about trials first.",
  },
  {
    n: "02",
    title: "Find your game",
    body: "10+ games run every week in divisions for every skill level. Pick yours from the schedule below.",
  },
  {
    n: "03",
    title: "Get involved",
    body: "Grab a £2.99 membership, try out in trials and come along to the weekly social.",
  },
];

const stats = [
  { value: `${totalPlacements}+`, label: "National placements" },
  { value: "10+", label: "Games a week" },
  { value: "£2.99", label: "Membership" },
];

const happenings = [
  { title: "Welsh Varsity", body: "We take on Cardiff University across every game, in person, over two days.", featured: true },
  { title: "Community events", body: "We run our own tournaments for games NSE doesn't cover, including Dead by Daylight and Minecraft speedrunning." },
  { title: "Weekly socials", body: "One in-person social every week. Day to be determined. Members only." },
  { title: "Tournaments", body: "We compete in NUEL, NSE and USS, nationally and locally." },
  { title: "Watch parties", body: "Viewing parties for big gaming events, from E3 to international finals." },
  { title: "In-houses", body: "Casual lobbies organised by our Game Reps, whatever your skill level." },
];
---

<BaseLayout title="About">
  <section class="border-b border-line/25 bg-brand-glow">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 md:py-24">
      <p class="font-display text-lg tracking-widest text-brand">{site.handle}</p>
      <h1 class="mt-2 font-display text-5xl leading-[0.95] tracking-wide text-offwhite sm:text-6xl">
        WHAT IS <span class="text-brand">SWANSEA ESPORTS?</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-offwhite/70">
        We're the esports society at Swansea University, competing in NSE and other university
        tournaments, with {totalPlacements}+ national placements to our name. There's room for
        every facet of esports, whether you want to play, stream, produce or write about games.
        When NSE doesn't cover a game, we run our own events.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {
          stats.map((s) => (
            <div>
              <p class="font-display text-4xl tracking-wide text-brand">{s.value}</p>
              <p class="text-xs uppercase tracking-widest text-offwhite/60">{s.label}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap items-start justify-center gap-2">
        <a
          href={site.discord}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 rounded bg-brand px-8 py-3.5 text-base font-semibold text-black transition-colors hover:bg-brand-dark"
        >
          <DiscordIcon size={20} class="shrink-0" />
          Join the Discord
        </a>
        <a
          href="/committee"
          class="rounded border border-line/35 px-6 py-3 text-base font-medium text-offwhite transition-colors hover:border-brand hover:text-brand"
        >
          Meet the Committee
        </a>
      </div>
      <div class="swan-frame mx-auto mt-10 flex h-40 w-40 items-center justify-center rounded-full">
        <img src="/brand/logo-crest.png" alt="Swansea Esports crest" width="678" height="800" class="h-32 w-auto opacity-90" />
      </div>
    </div>
  </section>

  <section class="border-b border-line/25 bg-brand-gradient">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="font-display text-3xl tracking-wide text-offwhite">How it works</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          steps.map((s) => (
            <div>
              <span class="font-display text-4xl tracking-wide text-brand">{s.n}</span>
              <h3 class="mt-2 font-display text-xl tracking-wide text-offwhite">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-offwhite/70">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="font-display text-3xl tracking-wide text-offwhite">Match schedule</h2>
        <p class="mt-1 text-sm text-offwhite/60">10+ games, every week, all between 7-9 PM GMT.</p>
      </div>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        schedule.map((d) => (
          <div class="rounded-xl border border-line/25 bg-panel p-5">
            <h3 class="font-display text-2xl tracking-wide text-brand">{d.day}</h3>
            <div class="mt-3 flex flex-col gap-2">
              {
                d.games.map((g) => (
                  <span class={`inline-flex items-center gap-2 rounded border px-2.5 py-1.5 text-sm text-offwhite/80 ${g.chip}`}>
                    <span class={`h-2 w-2 rounded-full ${g.dot}`} />
                    {g.name}
                  </span>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line/25 bg-brand-gradient">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
      <div>
        <h3 class="font-display text-xl tracking-wide text-brand">Trials</h3>
        <p class="mt-2 text-sm leading-relaxed text-offwhite/70">
          Online trials run one week before NSE starts. Exact dates not announced yet. Watch the
          Discord for the call.
        </p>
      </div>
      <div>
        <h3 class="font-display text-xl tracking-wide text-brand">Seasons</h3>
        <p class="mt-2 text-sm leading-relaxed text-offwhite/70">
          Each game runs in 4-7 week seasons, so there's always a fresh entry point through the year.
        </p>
      </div>
      <div>
        <h3 class="font-display text-xl tracking-wide text-brand">Divisions</h3>
        <p class="mt-2 text-sm leading-relaxed text-offwhite/70">
          Every game is split into divisions for all skill levels, from first-timers to competitive
          regulars.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-line/25 bg-panel p-6">
        <p class="font-display text-lg tracking-widest text-brand">MEMBERSHIP</p>
        <p class="mt-2 font-display text-5xl tracking-wide text-offwhite">£2.99</p>
        <p class="mt-3 text-sm leading-relaxed text-offwhite/70">
          A Students' Union membership is required to join teams and come to socials. Buy it on the
          Students' Union website. It's only £2.99.
        </p>
        <a
          href={site.studentsUnion}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-block rounded bg-brand px-6 py-3 text-sm font-semibold text-black transition-colors hover:bg-brand-dark"
        >
          Buy membership ↗
        </a>
      </div>
      <div class="rounded-xl border border-brand/50 bg-brand/5 p-6">
        <p class="font-display text-lg tracking-widest text-brand">FRESHERS WEEK QUIZ</p>
        <p class="mt-2 font-display text-3xl leading-tight tracking-wide text-offwhite">
          Win a free Battle Pass
        </p>
        <p class="mt-3 text-sm leading-relaxed text-offwhite/70">
          Take on our Freshers Week quiz and the winner picks a free Battle Pass for a game of their
          choice. You must be verified in the Discord to enter.
        </p>
        <a
          href={site.discord}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 rounded bg-brand px-6 py-3 text-sm font-semibold text-black transition-colors hover:bg-brand-dark"
        >
          <DiscordIcon size={16} class="shrink-0" />
          Join the Discord
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-3xl tracking-wide text-offwhite">What we get up to</h2>
      <a href="/events" class="text-sm font-medium text-brand transition-colors hover:text-brand-dark">All events →</a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        happenings.map((h) => (
          <div
            class:list={[
              "rounded-xl border p-5",
              h.featured ? "border-brand/50 bg-brand/5" : "border-line/25 bg-panel",
            ]}
          >
            <h3 class="font-display text-xl tracking-wide text-brand">{h.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-offwhite/70">{h.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line/25 bg-brand-gradient">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-10 sm:px-6 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-3xl tracking-wide text-offwhite">Ready to jump in?</h2>
        <p class="mt-1 max-w-xl text-sm text-offwhite/60">
          Trials run one week before NSE starts. Dates not announced yet. Everything runs online,
          with a division for everyone. The fastest way in is the Discord.
        </p>
      </div>
      <a
        href={site.discord}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2.5 rounded bg-brand px-6 py-3 text-base font-semibold text-black transition-colors hover:bg-brand-dark"
      >
        <DiscordIcon size={18} class="shrink-0" />
        Join the Discord
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 class="font-display text-3xl tracking-wide text-offwhite">Contact us</h2>
    <div class="mt-4 space-y-3 text-offwhite/80">
      <p>
        Email the committee at{" "}
        <a href={`mailto:${site.email}`} class="text-brand hover:underline">{site.email}</a>.
      </p>
      <p>
        For the fastest reply,{" "}
        <a href={site.discord} target="_blank" rel="noopener" class="text-brand hover:underline">join the Discord</a>{" "}
        and message a committee member directly.
      </p>
    </div>

    <h2 class="mt-10 font-display text-3xl tracking-wide text-offwhite">Follow us</h2>
    <div class="mt-4">
      <SocialLinks />
    </div>
  </section>
</BaseLayout>

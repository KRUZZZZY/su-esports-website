---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const now = new Date();
  const events = (await getCollection("events")).filter(
    (e) => !e.data.draft && e.data.ready && e.data.date <= now
  );
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, startDate, endDate, location, game, image, link, description, author, organiser } = entry.data;
const eventStart = startDate || date;
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={title} description={description}>
  <script is:inline>
    // Per-article view beacon — fires once per page load, no cookies.
    try {
      if (navigator.sendBeacon) {
        navigator.sendBeacon(
          "/api/view",
          new Blob([JSON.stringify({ type: "events", slug: "{slug}" })], { type: "application/json" })
        );
      }
    } catch (e) {}
  </script>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a href="/events" class="text-sm text-brand transition-colors hover:text-brand-dark">← All events</a>
    <h1 class="mt-4 font-display text-4xl leading-tight tracking-wide text-offwhite">{title}</h1>
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-offwhite/60">
      <time>{fmt(eventStart)}</time>
      {endDate && <time>until {fmt(endDate)}</time>}
      {game && <span>{game}</span>}
      {location && <span>{location}</span>}
      {organiser && <span>Organised by {organiser}</span>}
      {!organiser && author && author !== "Swansea Esports" && <span>by {author}</span>}
    </div>
    {image && <img src={image} alt="" class="mt-8 w-full rounded-xl border border-line/25" style="max-height:480px;object-fit:cover;object-position:center" />}
    <div class="prose prose-invert mt-8 max-w-none prose-a:text-brand">
      <Content />
    </div>
    {
      link && (
        <a href={link} target="_blank" rel="noopener" class="mt-6 inline-block rounded bg-brand px-5 py-2.5 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">
          Sign up / more info
        </a>
      )
    }
  </article>
</BaseLayout>

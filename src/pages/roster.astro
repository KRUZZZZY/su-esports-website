---
import BaseLayout from "../layouts/BaseLayout.astro";
import RosterCard from "../components/RosterCard.astro";
import { getCollection } from "astro:content";

const members = await getCollection("roster");
const games = [...new Set(members.map((m) => m.data.game))].sort();
---

<BaseLayout title="Roster">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl tracking-wide text-offwhite">Roster</h1>
    <p class="mt-2 text-offwhite/60">The players representing Swansea University Esports.</p>

    {
      games.map((game) => {
        const roster = members.filter((m) => m.data.game === game);
        return (
          <div class="mt-10">
            <h2 class="font-display text-2xl tracking-wide text-brand">{game}</h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {roster.map((m) => (
                <RosterCard name={m.data.name} ign={m.data.ign} game={m.data.game} role={m.data.role} photo={m.data.photo} socials={m.data.socials} />
              ))}
            </div>
          </div>
        );
      })
    }

    <p class="mt-12 text-sm text-offwhite/50">Want to play? Join the Discord and introduce yourself in the channels.</p>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import NewsCard from "../components/NewsCard.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const now = new Date();
const upcoming = (await getCollection("events"))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
const news = (await getCollection("news"))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const placements = await getCollection("placements");
const totalPlacements = placements.length;
const latestYear = Math.max(...placements.map((p) => p.data.year));
const medalRank: Record<string, number> = { "1st": 1, "2nd": 2, "3rd": 3 };
const latestPlacements = placements
  .filter((p) => p.data.year === latestYear)
  .sort((a, b) => (medalRank[a.data.medal] ?? 9) - (medalRank[b.data.medal] ?? 9));
---

<BaseLayout>
  <section class="border-b border-line/25 bg-brand-glow">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <p class="font-display text-lg tracking-widest text-brand">{site.handle}</p>
        <h1 class="mt-2 font-display text-5xl leading-[0.95] tracking-wide text-offwhite sm:text-6xl">
          SWANSEA<br />UNIVERSITY <span class="text-brand">ESPORTS</span>
        </h1>
        <p class="mt-4 max-w-md text-offwhite/70">{site.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={site.discord} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded bg-brand px-5 py-2.5 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">
            <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z" />
            </svg>
            Join the Discord
          </a>
          <a href={site.studentsUnion} target="_blank" rel="noopener" class="rounded border border-brand/50 px-5 py-2.5 text-sm font-medium text-brand transition-colors hover:bg-brand/10">
            Students' Union
          </a>
          <a href="/committee" class="rounded border border-line/35 px-5 py-2.5 text-sm font-medium text-offwhite transition-colors hover:border-brand hover:text-brand">
            Meet the Committee
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <div class="swan-frame rounded-3xl p-6">
          <img src="/brand/swan-wide.png" alt="Swansea Esports swan emblem" width="1600" height="646" class="w-full opacity-90" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line/25 bg-brand-gradient">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-6 sm:px-6 md:flex-row">
      <p class="font-display text-2xl tracking-wider text-offwhite">SUPPORT THE SOCIETY — GRAB THE MERCH</p>
      <a href={site.merch} target="_blank" rel="noopener" class="rounded bg-brand px-6 py-2.5 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">
        Shop the Merch Store ↗
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-3xl tracking-wide text-offwhite">Upcoming events</h2>
      <a href="/events" class="text-sm font-medium text-brand transition-colors hover:text-brand-dark">All events →</a>
    </div>
    {
      upcoming.length > 0 ? (
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((e) => (
            <EventCard title={e.data.title} date={e.data.date} endDate={e.data.endDate} location={e.data.location} game={e.data.game} image={e.data.image} href={`/events/${e.id}`} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-offwhite/60">No upcoming events yet — join the Discord to hear first.</p>
      )
    }
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-3xl tracking-wide text-offwhite">Latest news</h2>
      <a href="/news" class="text-sm font-medium text-brand transition-colors hover:text-brand-dark">All news →</a>
    </div>
    {
      news.length > 0 ? (
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {news.map((n) => (
            <NewsCard title={n.data.title} date={n.data.date} excerpt={n.data.excerpt} image={n.data.image} href={`/news/${n.id}`} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-offwhite/60">News coming soon.</p>
      )
    }
  </section>

  <section class="border-t border-line/25 bg-brand-gradient">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-10 sm:px-6 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-3xl tracking-wide text-offwhite">{totalPlacements} national placements</h2>
        <p class="mt-1 text-sm text-offwhite/60">
          Latest ({latestYear}): {latestPlacements.slice(0, 3).map((p) => `${p.data.medal} ${p.data.competition}`).join(" · ")}
        </p>
      </div>
      <a href="/achievements" class="rounded border border-line/35 px-5 py-2.5 text-sm font-medium text-offwhite transition-colors hover:border-brand hover:text-brand">
        Full competitive history →
      </a>
    </div>
  </section>
</BaseLayout>

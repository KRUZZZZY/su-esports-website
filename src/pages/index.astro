---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import NewsCard from "../components/NewsCard.astro";
import DiscordIcon from "../components/DiscordIcon.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const now = new Date();
const upcoming = (await getCollection("events"))
  .filter((e) => !e.data.draft && e.data.ready && e.data.date <= now && (e.data.startDate || e.data.date) >= now)
  .sort((a, b) => (a.data.startDate || a.data.date).getTime() - (b.data.startDate || b.data.date).getTime())
  .slice(0, 3);
const news = (await getCollection("news"))
  .filter((n) => !n.data.draft && n.data.ready && n.data.date <= now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const placements = await getCollection("placements");
const totalPlacements = placements.length;
const latestYear = Math.max(...placements.map((p) => p.data.year));
const medalRank: Record<string, number> = { "1st": 1, "2nd": 2, "3rd": 3 };
const latestPlacements = placements
  .filter((p) => p.data.year === latestYear)
  .sort((a, b) => (medalRank[a.data.medal] ?? 9) - (medalRank[b.data.medal] ?? 9));
---

<BaseLayout>
  <section class="border-b border-line/25 bg-brand-glow">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <p class="font-display text-lg tracking-widest text-brand">{site.handle}</p>
        <h1 class="mt-2 font-display text-5xl leading-[0.95] tracking-wide text-offwhite sm:text-6xl">
          SWANSEA<br />UNIVERSITY <span class="text-brand">ESPORTS</span>
        </h1>
        <p class="mt-4 max-w-md text-offwhite/70">{site.description}</p>
        <div class="mt-6 flex flex-wrap items-start gap-2">
          <div class="flex flex-col items-start gap-2">
            <a href={site.discord} target="_blank" rel="noopener" data-track="join-discord-hero" class="inline-flex items-center gap-2.5 rounded bg-brand px-8 py-3.5 text-base font-semibold text-black transition-colors hover:bg-brand-dark">
              <DiscordIcon size={20} class="shrink-0" />
              Join the Discord
            </a>
            <p class="text-sm leading-snug text-offwhite/70">Everything happens here!</p>
          </div>
          <a href={site.studentsUnion} target="_blank" rel="noopener" data-track="students-union-hero" class="rounded border border-brand/50 px-6 py-3 text-base font-medium text-brand transition-colors hover:bg-brand/10">
            Students' Union
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <a
          href={site.discord}
          target="_blank"
          rel="noopener"
          data-track="swan-discord-hero"
          aria-label="Join the Swansea Esports Discord"
          class="swan-frame block rounded-3xl p-6 transition-opacity hover:opacity-80"
        >
          <img src="/brand/swan-wide.png" alt="Swansea Esports swan emblem" width="1600" height="646" class="w-full opacity-90" />
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-line/25 bg-brand-gradient">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-6 sm:px-6 md:flex-row">
      <p class="font-display text-2xl tracking-wider text-offwhite">SUPPORT THE SOCIETY — GRAB THE MERCH</p>
      <a href={site.merch} target="_blank" rel="noopener" data-track="merch-banner" class="rounded bg-brand px-6 py-2.5 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">
        Shop the Merch Store ↗
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-3xl tracking-wide text-offwhite">Upcoming events</h2>
      <a href="/events" class="text-sm font-medium text-brand transition-colors hover:text-brand-dark">All events →</a>
    </div>
    {
      upcoming.length > 0 ? (
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((e) => (
            <EventCard title={e.data.title} date={e.data.startDate || e.data.date} endDate={e.data.endDate} location={e.data.location} game={e.data.game} organiser={e.data.organiser} image={e.data.image} thumbnail={e.data.thumbnail} href={`/events/${e.id}`} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-offwhite/60">No upcoming events yet — join the Discord to hear first.</p>
      )
    }
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-3xl tracking-wide text-offwhite">Latest news</h2>
      <a href="/news" class="text-sm font-medium text-brand transition-colors hover:text-brand-dark">All news →</a>
    </div>
    {
      news.length > 0 ? (
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {news.map((n) => (
            <NewsCard title={n.data.title} date={n.data.date} excerpt={n.data.excerpt} image={n.data.image} href={`/news/${n.id}`} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-offwhite/60">News coming soon.</p>
      )
    }
  </section>

  <section class="border-t border-line/25 bg-brand-gradient">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-10 sm:px-6 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-3xl tracking-wide text-offwhite">{totalPlacements} national placements</h2>
        <p class="mt-1 text-sm text-offwhite/60">
          Latest ({latestYear}): {latestPlacements.slice(0, 3).map((p) => `${p.data.medal} ${p.data.competition}`).join(" · ")}
        </p>
      </div>
      <a href="/achievements" class="rounded border border-line/35 px-5 py-2.5 text-sm font-medium text-offwhite transition-colors hover:border-brand hover:text-brand">
        Full competitive history →
      </a>
    </div>
  </section>
</BaseLayout>

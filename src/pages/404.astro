---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <h1 class="font-display text-6xl tracking-widest text-brand">404</h1>
    <p class="mt-4 text-offwhite/70">That page doesn't exist.</p>
    <a href="/" class="mt-6 inline-block rounded bg-brand px-5 py-2.5 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">
      Back home
    </a>
  </section>
</BaseLayout>

---
import "../../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin · Swansea Esports</title>
    <meta name="description" content="Swansea Esports admin — manage news and events." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="bg-ink text-offwhite">
    <div class="min-h-screen bg-brand-glow">
      <header class="border-b border-white/10 bg-ink/85 backdrop-blur">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
          <div class="flex items-center gap-3">
            <img src="/brand/swan-head.png" alt="" width="36" height="36" class="h-9 w-9" />
            <span class="font-display text-xl tracking-widest text-offwhite">
              SWANSEA <span class="text-brand">ESPORTS</span>
              <span class="text-offwhite/50">— Admin</span>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <a href="/" class="rounded border border-white/15 px-3 py-1.5 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">
              View site ↗
            </a>
            <a href="/admin/analytics" id="nav-analytics" class="rounded border border-white/15 px-3 py-1.5 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">
              Analytics
            </a>
            <button
              id="signout-btn"
              class="hidden rounded border border-white/15 px-3 py-1.5 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite"
            >
              Sign out
            </button>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <!-- ============ LOGIN ============ -->
        <section id="login-view" class="hidden">
          <div class="mx-auto max-w-md rounded-xl border border-white/10 bg-panel p-8">
            <h1 class="font-display text-3xl tracking-wider text-brand">Sign in</h1>
            <p class="mt-2 text-sm text-offwhite/60">Admin or editor access for Swansea Esports committee members.</p>
            <form id="login-form" class="mt-6 space-y-4">
              <div>
                <label for="login-email" class="block text-sm font-medium text-offwhite/80">Email</label>
                <input id="login-email" type="email" required autocomplete="username" class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <div>
                <label for="login-password" class="block text-sm font-medium text-offwhite/80">Password</label>
                <input id="login-password" type="password" required autocomplete="current-password" class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <p id="login-error" class="hidden text-sm text-red-400" aria-live="polite"></p>
              <button type="submit" id="login-btn" class="w-full rounded-lg bg-brand px-4 py-2.5 font-semibold text-black transition-colors hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-60">
                Sign in
              </button>
            </form>
          </div>
        </section>

        <!-- ============ LIST ============ -->
        <section id="list-view" class="hidden">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="font-display text-3xl tracking-wider text-brand">Content</h1>
            <div class="flex gap-2">
              <button id="new-news-btn" class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">＋ New news post</button>
              <button id="new-event-btn" class="rounded-lg border border-brand/50 px-4 py-2 text-sm font-medium text-brand transition-colors hover:bg-brand/10">＋ New event</button>
            </div>
          </div>
          <p id="list-status" class="mt-4 text-sm text-offwhite/50" aria-live="polite">Loading…</p>

          <div class="mt-5">
            <label for="list-search" class="block text-sm font-medium text-offwhite/80">Search content</label>
            <input id="list-search" type="search" placeholder="Filter by title, author or organiser…"
              class="mt-1 w-full max-w-md rounded-lg border border-white/10 bg-ink px-3 py-2 text-offwhite outline-none transition-colors focus:border-brand" />
            <p class="mt-1 text-xs text-offwhite/50">Filters both lists as you type.</p>
          </div>

          <h2 class="mt-8 font-display text-xl tracking-wider text-offwhite">News</h2>
          <div class="mt-3 flex flex-wrap gap-2 text-xs text-offwhite/50">
            <span class="mr-1 py-1.5">Sort:</span>
            <button data-sort="news" data-key="date" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Date</button>
            <button data-sort="news" data-key="title" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Title</button>
            <button data-sort="news" data-key="author" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Author</button>
            <button data-sort="news" data-key="status" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Status</button>
          </div>
          <div id="list-news" class="mt-3 grid gap-3 sm:grid-cols-2"></div>
          <p id="list-news-empty" class="hidden mt-3 text-sm text-offwhite/50">No news posts yet.</p>

          <h2 class="mt-8 font-display text-xl tracking-wider text-offwhite">Events</h2>
          <div class="mt-3 flex flex-wrap gap-2 text-xs text-offwhite/50">
            <span class="mr-1 py-1.5">Sort:</span>
            <button data-sort="events" data-key="date" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Date</button>
            <button data-sort="events" data-key="title" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Title</button>
            <button data-sort="events" data-key="author" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Organiser</button>
            <button data-sort="events" data-key="status" class="rounded border border-white/15 px-2.5 py-1.5 transition-colors hover:border-white/30 hover:text-offwhite">Status</button>
          </div>
          <div id="list-events" class="mt-3 grid gap-3 sm:grid-cols-2"></div>
          <p id="list-events-empty" class="hidden mt-3 text-sm text-offwhite/50">No events yet.</p>
        </section>

        <!-- ============ CREATE DIALOG ============ -->
        <section id="create-view" class="hidden">
          <div class="mx-auto max-w-md rounded-xl border border-white/10 bg-panel p-8">
            <h1 id="create-heading" class="font-display text-3xl tracking-wider text-brand">New news post</h1>
            <p class="mt-2 text-sm text-offwhite/60">Name and author/organiser are required before we create the draft.</p>
            <form id="create-form" class="mt-6 space-y-4">
              <div>
                <label for="c-title" class="block text-sm font-medium text-offwhite/80">Name / title</label>
                <input id="c-title" type="text" maxlength="200" required placeholder="e.g. Freshers LAN 2026"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <div>
                <label for="c-author" id="c-author-label" class="block text-sm font-medium text-offwhite/80">Author</label>
                <input id="c-author" type="text" maxlength="100" required placeholder="Your name"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <p id="create-error" class="hidden text-sm text-red-400" aria-live="polite"></p>
              <div class="flex gap-3">
                <button type="submit" id="create-btn" class="flex-1 rounded-lg bg-brand px-4 py-2.5 font-semibold text-black transition-colors hover:bg-brand-dark">Create draft</button>
                <button type="button" id="create-cancel" class="rounded-lg border border-white/15 px-4 py-2.5 text-sm font-medium text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Cancel</button>
              </div>
            </form>
          </div>
        </section>

        <!-- ============ EDITOR (single page, no steps) ============ -->
        <section id="editor-view" class="hidden">
          <div class="rounded-xl border border-white/10 bg-panel p-6 sm:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <a href="#" id="editor-back-link" class="text-sm text-offwhite/60 transition-colors hover:text-offwhite">← Back to content</a>
                <h1 id="editor-heading" class="mt-1 font-display text-3xl tracking-wider text-brand">New news post</h1>
              </div>
              <div class="flex items-center gap-3">
                <span id="editor-status" class="rounded-full border border-white/15 px-3 py-1 text-xs font-medium text-offwhite/50" role="status" aria-live="polite"></span>
                <span id="editor-views" class="hidden rounded-full border border-white/15 px-3 py-1 text-xs font-medium text-offwhite/50" title="Views (human / bot)"></span>
                <a href="#" id="editor-preview-link" class="hidden rounded-full border border-white/15 px-3 py-1 text-xs font-medium text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Preview ↗</a>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <button id="btn-save" class="rounded-lg bg-brand px-5 py-2 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">Save</button>
              <button id="btn-duplicate" class="rounded-lg border border-white/15 px-4 py-2 text-sm font-medium text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Duplicate</button>
              <button id="btn-publish" class="rounded-lg border border-emerald-400/50 px-4 py-2 text-sm font-medium text-emerald-300 transition-colors hover:bg-emerald-400/10">Publish now</button>
              <span id="editor-hint" class="self-center text-xs text-offwhite/50"></span>
            </div>

            <p id="editor-error" class="mt-4 hidden rounded-lg border border-red-400/30 bg-red-400/5 px-4 py-2 text-sm text-red-300" aria-live="polite"></p>

            <!-- Title -->
            <div class="mt-6">
              <label for="w-title" class="block text-sm font-medium text-offwhite/80">Title</label>
              <input id="w-title" type="text" maxlength="200" placeholder="e.g. Welcome to the new website"
                class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              <p class="mt-1 text-xs text-offwhite/50">Page URL: <span id="w-slug-hint" class="text-brand">—</span></p>
            </div>

            <!-- Publish gate -->
            <div class="mt-6 rounded-lg border border-brand/30 bg-brand/5 p-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-medium text-offwhite">Publish settings</p>
                  <p class="mt-1 text-xs leading-relaxed text-offwhite/60">
                    Tick <strong>Ready</strong> when the article is finished. It will go live automatically at the
                    <strong>publish date &amp; time</strong> below (hidden until then). <strong>Publish now</strong>
                    sets the publish time to this moment. Until it's live, the article is a private draft.
                  </p>
                </div>
                <label class="flex shrink-0 cursor-pointer items-center gap-2 rounded-lg border border-white/15 px-3 py-2">
                  <input id="w-ready" type="checkbox" class="h-4 w-4 accent-[#e08f20]" />
                  <span class="text-sm font-semibold text-offwhite">Ready ✓</span>
                </label>
              </div>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <div>
                  <label for="w-date" class="block text-sm font-medium text-offwhite/80">Publish date &amp; time</label>
                  <input id="w-date" type="datetime-local"
                    class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
                  <p class="mt-1 text-xs text-offwhite/50">The article goes live at this time (if Ready is ticked).</p>
                </div>
                <div>
                  <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-white/15 px-3 py-2.5">
                    <input id="w-sponsored" type="checkbox" class="h-4 w-4 accent-[#e08f20]" />
                    <span class="text-sm text-offwhite/80">Sponsored — hide from search engines</span>
                  </label>
                  <p class="mt-1 text-xs text-offwhite/50">Sponsored posts are excluded from the sitemap so Google etc. don't index them.</p>
                </div>
              </div>
            </div>

            <!-- Type-specific fields -->
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <div id="w-author-wrap">
                <label for="w-author" class="block text-sm font-medium text-offwhite/80">Author</label>
                <input id="w-author" type="text" maxlength="100" placeholder="Swansea Esports"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <div id="w-category-wrap" class="hidden">
                <label for="w-category" class="block text-sm font-medium text-offwhite/80">Category (optional)</label>
                <input id="w-category" type="text" maxlength="60" list="cat-suggestions" placeholder="e.g. Announcement"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
                <datalist id="cat-suggestions">
                  <option value="Announcement"></option>
                  <option value="Match Report"></option>
                  <option value="Results"></option>
                  <option value="Community"></option>
                  <option value="Esports News"></option>
                  <option value="Other"></option>
                </datalist>
                <p class="mt-1 text-xs text-offwhite/50">Shown as a badge on news cards. Max 60 characters.</p>
              </div>
              <div id="w-organiser-wrap" class="hidden">
                <label for="w-organiser" class="block text-sm font-medium text-offwhite/80">Event organiser (optional)</label>
                <input id="w-organiser" type="text" maxlength="100" placeholder="e.g. Lewis Dasilva"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
                <p class="mt-1 text-xs text-offwhite/50">Who is running this event.</p>
              </div>
              <div id="w-startdate-wrap" class="hidden">
                <label for="w-startdate" class="block text-sm font-medium text-offwhite/80">Start date (optional)</label>
                <input id="w-startdate" type="datetime-local"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
                <p class="mt-1 text-xs text-offwhite/50">When the event actually starts (shown on the event page).</p>
              </div>
              <div id="w-enddate-wrap" class="hidden">
                <label for="w-enddate" class="block text-sm font-medium text-offwhite/80">End date (optional)</label>
                <input id="w-enddate" type="datetime-local"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <div id="w-location-wrap" class="hidden">
                <label for="w-location" class="block text-sm font-medium text-offwhite/80">Location (optional)</label>
                <input id="w-location" type="text" maxlength="200" placeholder="e.g. Fulton House, Room 101"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <div id="w-game-wrap" class="hidden">
                <label for="w-game" class="block text-sm font-medium text-offwhite/80">Game (optional)</label>
                <input id="w-game" type="text" maxlength="200" placeholder="e.g. League of Legends"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
              <div id="w-link-wrap" class="hidden">
                <label for="w-link" class="block text-sm font-medium text-offwhite/80">Sign-up link (optional)</label>
                <input id="w-link" type="text" maxlength="200" placeholder="https://…"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand" />
              </div>
            </div>

            <!-- Intro / teaser (news) + description (events) -->
            <div id="w-intro-wrap" class="mt-6">
              <label for="w-intro" class="block text-sm font-medium text-offwhite/80">Introduction (optional)</label>
              <textarea id="w-intro" rows="2" maxlength="300" placeholder="One or two sentences shown at the top of the article…"
                class="mt-1 w-full resize-y rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand"></textarea>
              <p class="mt-1 text-xs text-offwhite/50">Max 300 characters.</p>
            </div>
            <div id="w-teaser-wrap" class="mt-6">
              <label for="w-teaser" class="block text-sm font-medium text-offwhite/80">Teaser (optional)</label>
              <textarea id="w-teaser" rows="2" maxlength="160" placeholder="A punchy hook for the news card…"
                class="mt-1 w-full resize-y rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand"></textarea>
              <p class="mt-1 text-xs text-offwhite/50">Shown on cards before you click through. Max 160 characters.</p>
            </div>
            <div id="w-desc-wrap" class="mt-6 hidden">
              <label for="w-desc" class="block text-sm font-medium text-offwhite/80">Description (optional)</label>
              <textarea id="w-desc" rows="2" maxlength="200" placeholder="A short description shown on the events listing…"
                class="mt-1 w-full resize-y rounded-lg border border-white/10 bg-ink px-3 py-2.5 text-offwhite outline-none transition-colors focus:border-brand"></textarea>
              <p class="mt-1 text-xs text-offwhite/50">Max 200 characters.</p>
            </div>

            <!-- Intro image -->
            <div class="mt-6">
              <span class="block text-sm font-medium text-offwhite/80">Intro image (optional)</span>
              <p class="mt-0.5 text-xs text-offwhite/50">The hero image at the top of the article. Defaults to the swan banner.</p>
              <div class="mt-2 flex flex-wrap items-center gap-3">
                <img id="w-image-preview" alt="Intro image preview" class="hidden h-20 w-36 rounded-lg border border-white/10 object-cover" />
                <button id="w-image-pick" type="button" class="rounded-lg border border-white/15 px-3 py-2 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Choose image</button>
                <button id="w-image-remove" class="hidden rounded-lg border border-white/15 px-3 py-2 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Remove</button>
              </div>
              <p id="w-image-status" class="mt-2 text-xs text-offwhite/50"></p>
            </div>

            <!-- Thumbnail (16:9 crop) -->
            <div class="mt-6">
              <span class="block text-sm font-medium text-offwhite/80">Thumbnail (optional)</span>
              <p class="mt-0.5 text-xs text-offwhite/50">The card image — cropped to 16:9 and converted to WebP.</p>
              <div class="mt-2 flex flex-wrap items-center gap-3">
                <img id="w-thumb-preview" alt="Thumbnail preview" class="hidden h-20 w-36 rounded-lg border border-white/10 object-cover" />
                <button id="w-thumb-pick" type="button" class="rounded-lg border border-white/15 px-3 py-2 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Choose thumbnail</button>
                <button id="w-thumb-remove" class="hidden rounded-lg border border-white/15 px-3 py-2 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Remove</button>
              </div>
              <p id="w-thumb-status" class="mt-2 text-xs text-offwhite/50"></p>
            </div>

            <!-- Body blocks -->
            <div class="mt-6">
              <span class="block text-sm font-medium text-offwhite/80">Content</span>
              <p class="mt-0.5 text-xs text-offwhite/60">Text blocks support <span class="text-brand">markdown</span>; image blocks insert a picture between blocks.</p>
              <div id="block-list" class="mt-3 space-y-3"></div>
              <div class="mt-4 flex flex-wrap gap-2">
                <button id="add-text-btn" class="rounded-lg border border-brand/50 px-4 py-2 text-sm font-medium text-brand transition-colors hover:bg-brand/10">＋ Add text block</button>
                <button id="add-image-btn" class="rounded-lg border border-brand/50 px-4 py-2 text-sm font-medium text-brand transition-colors hover:bg-brand/10">＋ Add image block</button>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ MEDIA PICKER MODAL ============ -->
        <div id="media-modal" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-label="Media library">
          <div id="media-overlay" class="absolute inset-0 bg-black/70"></div>
          <div class="relative mx-auto mt-16 w-[calc(100%-2rem)] max-w-3xl rounded-xl border border-white/10 bg-panel p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="font-display text-xl tracking-wider text-brand">Media library</h2>
                <p id="media-status" class="mt-1 text-xs text-offwhite/50" aria-live="polite">Loading images…</p>
              </div>
              <div class="flex gap-2">
                <label class="cursor-pointer rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-brand-dark">
                  ＋ Upload new
                  <input id="media-file" type="file" accept="image/*" class="hidden" />
                </label>
                <button id="media-close" type="button" class="rounded-lg border border-white/15 px-3 py-2 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Close</button>
              </div>
            </div>
            <div id="media-grid" class="mt-4 grid max-h-[55vh] grid-cols-3 gap-2 overflow-y-auto sm:grid-cols-4"></div>
            <p id="media-empty" class="hidden mt-4 text-sm text-offwhite/50">No images yet — upload one to get started.</p>
          </div>
        </div>

        <!-- ============ THUMBNAIL CROP MODAL ============ -->
        <div id="crop-modal" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-label="Crop thumbnail">
          <div id="crop-overlay" class="absolute inset-0 bg-black/70"></div>
          <div class="relative mx-auto mt-10 w-[calc(100%-2rem)] max-w-2xl rounded-xl border border-white/10 bg-panel p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-display text-xl tracking-wider text-brand">Crop thumbnail</h2>
              <button id="crop-close" type="button" class="rounded-lg border border-white/15 px-3 py-2 text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">Cancel</button>
            </div>
            <p class="mt-1 text-xs text-offwhite/50">Drag to pan, use the slider to zoom. The crop is 16:9.</p>
            <div id="crop-stage" class="relative mt-4 aspect-video w-full select-none overflow-hidden rounded-lg border border-white/10 bg-black">
              <img id="crop-img" alt="Source image for cropping" draggable="false"
                class="absolute max-w-none cursor-grab active:cursor-grabbing" style="left:0;top:0" />
            </div>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div>
                <label for="crop-zoom" class="block text-sm font-medium text-offwhite/80">Zoom</label>
                <input id="crop-zoom" type="range" min="100" max="400" step="1" value="100" class="mt-2 w-full accent-[#e08f20]" />
                <label class="mt-3 block cursor-pointer rounded-lg border border-white/15 px-3 py-2 text-center text-sm text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite">
                  Upload a different image
                  <input id="crop-file" type="file" accept="image/*" class="hidden" />
                </label>
              </div>
              <div>
                <span class="block text-sm font-medium text-offwhite/80">Live preview</span>
                <canvas id="crop-preview" width="320" height="180" class="mt-2 aspect-video w-full rounded-lg border border-white/10 bg-black"></canvas>
              </div>
            </div>
            <p class="mt-3 text-xs text-offwhite/50">Minimum 800px wide recommended.</p>
            <div class="mt-4 flex gap-3">
              <button id="crop-apply" type="button" class="flex-1 rounded-lg bg-brand px-4 py-2.5 font-semibold text-black transition-colors hover:bg-brand-dark">Apply crop</button>
            </div>
          </div>
        </div>
      </main>
    </div>

    <script type="module" is:inline>
      (function () {
        "use strict";

        const $ = (id) => document.getElementById(id);
        const API = "/api/content";

        let role = "admin"; // set from /api/auth/me on boot
        let state = {
          view: "login", // login | list | editor
          mode: "create", // create | edit
          type: "news",
          slug: null,
          sha: null,
          draft: true,
          ready: false,
          sponsored: false,
          title: "",
          date: "",
          author: "Swansea Esports",
          category: "",
          intro: "",
          teaser: "",
          organiser: "",
          startDate: "",
          endDate: "",
          description: "",
          location: "",
          game: "",
          link: "",
          image: "",
          thumbnail: "",
          blocks: [],
        };

        let dirty = false;

        // ---- helpers ----------------------------------------------------------
        function todayLocal() {
          const d = new Date();
          d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
          return d.toISOString().slice(0, 16); // YYYY-MM-DDTHH:MM for datetime-local
        }

        function randomSlug() {
          const chars = "abcdefghijklmnopqrstuvwxyz0123456789";
          let s = "";
          for (let i = 0; i < 8; i++) s += chars[Math.floor(Math.random() * chars.length)];
          return s;
        }

        function formatDate(iso) {
          if (!iso) return "";
          const d = new Date(iso.length === 16 ? iso + ":00" : iso);
          return Number.isNaN(d.getTime())
            ? ""
            : d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
        }

        function setStatus(text) {
          $("editor-status").textContent = text;
        }

        function setError(msg) {
          const el = $("editor-error");
          el.textContent = msg || "";
          el.classList.toggle("hidden", !msg);
        }

        // ---- views -------------------------------------------------------------
        function showView(name) {
          state.view = name;
          ["login", "list", "create", "editor"].forEach((v) => {
            $(v + "-view").classList.toggle("hidden", v !== name);
          });
          $("signout-btn").classList.toggle("hidden", name === "login");
          $("nav-analytics").classList.toggle("hidden", name === "login" || role !== "admin");
        }

        // ---- list ---------------------------------------------------------------
        const listStore = { news: [], events: [] };
        const listSort = { news: { key: "date", dir: -1 }, events: { key: "date", dir: -1 } };

        async function fetchList() {
          const status = $("list-status");
          status.textContent = "Loading…";
          status.classList.remove("hidden");
          try {
            const [newsRes, eventsRes] = await Promise.all([
              fetch(API + "?type=news"),
              fetch(API + "?type=events"),
            ]);
            const newsData = await newsRes.json().catch(() => ({}));
            const eventsData = await eventsRes.json().catch(() => ({}));
            listStore.news = Array.isArray(newsData.items) ? newsData.items : [];
            listStore.events = Array.isArray(eventsData.items) ? eventsData.items : [];
            renderList("news");
            renderList("events");
            status.classList.add("hidden");
          } catch (e) {
            status.textContent = "Could not load content — refresh to try again.";
          }
        }

        function sortItems(type) {
          const { key, dir } = listSort[type];
          const items = [...listStore[type]];
          const val = (it) => {
            if (key === "title") return String(it.title || "").toLowerCase();
            if (key === "author") return String(it.author || it.organiser || "").toLowerCase();
            if (key === "status") return it.ready === true || it.ready === "true" ? 1 : 0;
            return String(it.date || "");
          };
          items.sort((a, b) => {
            const va = val(a);
            const vb = val(b);
            return va < vb ? -dir : va > vb ? dir : 0;
          });
          return items;
        }

        function renderList(type) {
          const container = $(type === "news" ? "list-news" : "list-events");
          const empty = $(type === "news" ? "list-news-empty" : "list-events-empty");
          container.textContent = "";
          const q = ($("list-search").value || "").trim().toLowerCase();
          let items = sortItems(type);
          if (q) {
            items = items.filter((it) => {
              const hay = [it.title, it.author, it.organiser, it.category].filter(Boolean).join(" ").toLowerCase();
              return hay.includes(q);
            });
          }
          empty.classList.toggle("hidden", items.length > 0);
          items.forEach((item) => {
            const card = document.createElement("div");
            card.className = "flex flex-col overflow-hidden rounded-lg border border-white/10 bg-panel";

            // Thumbnail (16:9) or branded placeholder.
            const thumbSrc = item.thumbnail || item.image;
            if (thumbSrc) {
              const thumbWrap = document.createElement("div");
              thumbWrap.className = "aspect-video w-full overflow-hidden bg-black/30";
              const img = document.createElement("img");
              img.src = thumbSrc;
              img.alt = "";
              img.loading = "lazy";
              img.className = "h-full w-full object-cover";
              thumbWrap.append(img);
              card.append(thumbWrap);
            } else {
              const placeholder = document.createElement("div");
              placeholder.className = "flex aspect-video w-full items-center justify-center bg-brand-gradient";
              const swan = document.createElement("img");
              swan.src = "/brand/swan-head-clean.png";
              swan.alt = "";
              swan.className = "h-12 w-12 object-contain opacity-40";
              placeholder.append(swan);
              card.append(placeholder);
            }

            const body = document.createElement("div");
            body.className = "flex flex-1 flex-col p-4";

            const titleRow = document.createElement("div");
            titleRow.className = "flex flex-wrap items-center gap-2";
            const title = document.createElement("p");
            title.className = "min-w-0 truncate font-medium text-offwhite";
            title.textContent = item.title || "(untitled)";
            titleRow.append(title);
            const badge = document.createElement("span");
            badge.className = "shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider";
            if (item.ready === true || item.ready === "true") {
              badge.textContent = "Live";
              badge.className += " border-emerald-400/50 text-emerald-300";
            } else {
              badge.textContent = "Draft";
              badge.className += " border-amber-400/50 text-amber-300";
            }
            titleRow.append(badge);
            if (item.sponsored === true || item.sponsored === "true") {
              const sp = document.createElement("span");
              sp.textContent = "Sponsored";
              sp.className = "shrink-0 rounded-full border border-white/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-offwhite/50";
              titleRow.append(sp);
            }
            if (item.category) {
              const cat = document.createElement("span");
              cat.textContent = item.category;
              cat.className = "shrink-0 rounded-full border border-brand/40 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand";
              titleRow.append(cat);
            }

            const meta = document.createElement("p");
            meta.className = "mt-1.5 text-xs text-offwhite/50";
            const who = type === "news" ? item.author : item.organiser;
            meta.textContent = (item.date ? formatDate(item.date) : "—") + (who ? " · " + who : "");
            body.append(titleRow, meta);

            const actions = document.createElement("div");
            actions.className = "mt-3 flex flex-wrap gap-2 border-t border-white/10 pt-3";
            const mkAct = (txt, cls, onClick) => {
              const b = document.createElement("button");
              b.type = "button";
              b.className =
                "rounded border border-white/15 px-2.5 py-1 text-xs font-medium text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite" +
                (cls ? " " + cls : "");
              b.textContent = txt;
              b.addEventListener("click", onClick);
              return b;
            };
            actions.append(
              mkAct("Edit", "", () => openEditor(type, item.slug)),
              mkAct("Preview", "", () => window.open(`/api/preview?type=${encodeURIComponent(type)}&slug=${encodeURIComponent(item.slug)}`, "_blank")),
              mkAct("Duplicate", "", () => duplicateFromList(type, item)),
              mkAct("Delete", "hover:border-red-400/50 hover:text-red-400", () => deleteArticle(type, item.slug, item.title || item.slug))
            );
            body.append(actions);

            card.append(body);
            container.append(card);
          });
        }

        async function duplicateFromList(type, item) {
          try {
            const res = await fetch(`${API}?type=${encodeURIComponent(type)}&slug=${encodeURIComponent(item.slug)}`);
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
              window.alert((data && data.error) || "Could not load the article to duplicate.");
              return;
            }
            const slug = randomSlug();
            const payload = {
              type,
              slug,
              title: ((item.title || "Untitled").trim()) + " (copy)",
              date: todayLocal(),
              body: typeof data.body === "string" ? data.body : "",
              draft: true,
              ready: false,
              sponsored: data.sponsored === true || data.sponsored === "true",
            };
            if (type === "news") {
              payload.author = data.author || "Swansea Esports";
              if (data.category) payload.category = data.category;
              if (data.intro) payload.intro = data.intro;
              if (data.teaser) payload.teaser = data.teaser;
            } else {
              if (data.organiser) payload.organiser = data.organiser;
              ["startDate", "endDate", "location", "game", "link", "description"].forEach((k) => {
                if (data[k]) payload[k] = data[k];
              });
            }
            if (data.image) payload.image = data.image;
            if (data.thumbnail) payload.thumbnail = data.thumbnail;
            const r = await fetch(API, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const rd = await r.json().catch(() => ({}));
            if (!r.ok) {
              window.alert((rd && rd.error) || "Could not duplicate the article.");
              return;
            }
            state.mode = "edit";
            state.type = type;
            state.slug = rd.slug || slug;
            showView("editor");
            await loadArticle();
          } catch (e) {
            window.alert("Network error — could not duplicate the article.");
          }
        }

        async function deleteArticle(type, slug, title) {
          if (!window.confirm(`Delete "${title}"? This cannot be undone.`)) return;
          try {
            const res = await fetch(`${API}?type=${encodeURIComponent(type)}&slug=${encodeURIComponent(slug)}`, { method: "DELETE" });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
              window.alert((data && data.error) || "Delete failed — try again.");
              return;
            }
            await fetchList();
          } catch (e) {
            window.alert("Network error — check your connection and try again.");
          }
        }

        // ---- editor ---------------------------------------------------------------
        let createType = "news"; // which type the create dialog is for

        // Create = dialog (force name + author) → POST draft with a random slug → editor.
        function showCreateDialog(type) {
          createType = type;
          $("create-heading").textContent = type === "news" ? "New news post" : "New event";
          $("c-title").value = "";
          $("c-author").value = "";
          // Events credit the organiser instead of an author.
          const isNews = type === "news";
          $("c-author-label").textContent = isNews ? "Author" : "Organiser";
          $("c-author").placeholder = isNews ? "Your name" : "Who is running it?";
          $("create-error").classList.add("hidden");
          showView("create");
          setTimeout(() => $("c-title").focus(), 50);
        }

        async function createArticle(type, name, authorOrOrganiser) {
          try {
            const slug = randomSlug();
            const payload = {
              type,
              slug,
              title: name,
              date: todayLocal(),
              body: "",
              draft: true,
              ready: false,
              sponsored: false,
            };
            if (type === "news") {
              payload.author = authorOrOrganiser || "Swansea Esports";
            } else {
              payload.organiser = authorOrOrganiser || "";
            }
            const res = await fetch(API, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
              window.alert((data && data.error) || "Could not create the article.");
              return false;
            }
            // Go straight to the editor for the new draft.
            state.mode = "edit";
            state.type = type;
            state.slug = data.slug;
            await loadArticle();
            return true;
          } catch (e) {
            window.alert("Network error — could not create the article.");
            return false;
          }
        }

        // Duplicate: copy the current article (content + fields) to a fresh
        // random-slug draft and open it in the editor.
        async function duplicateArticle() {
          if (!state.slug) return;
          try {
            const payload = collectPayload();
            payload.slug = randomSlug();
            payload.title = (payload.title.trim() ? payload.title.trim() : "Untitled") + " (copy)";
            payload.draft = true;
            payload.ready = false;
            payload.date = todayLocal();
            const res = await fetch(API, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
              window.alert((data && data.error) || "Could not duplicate the article.");
              return;
            }
            state.mode = "edit";
            state.slug = data.slug;
            await loadArticle();
          } catch (e) {
            window.alert("Network error — could not duplicate the article.");
          }
        }

        // Publish now: sets publish time to this moment + ready, then saves.
        async function publishNow() {
          state.ready = true;
          state.date = todayLocal();
          $("w-ready").checked = true;
          $("w-date").value = state.date;
          const r = await saveNow();
          if (r.ok) {
            setStatus("Published ✓");
            $("editor-hint").textContent = "Live now (after the rebuild).";
            updateReadyUI();
          }
        }

        function openEditor(type, slug) {
          state.type = type;
          state.slug = slug;
          state.mode = "edit";
          showView("editor");
          loadArticle();
        }

        async function loadArticle() {
          setStatus("Loading…");
          try {
            const res = await fetch(`${API}?type=${encodeURIComponent(state.type)}&slug=${encodeURIComponent(state.slug)}`);
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
              setError((data && data.error) || "Could not load the article.");
              return;
            }
            state.sha = data.sha || null;
            state.title = typeof data.title === "string" ? data.title : "";
            state.date = normalizeDate(data.date);
            state.ready = data.ready === true || data.ready === "true";
            state.sponsored = data.sponsored === true || data.sponsored === "true";
            state.draft = data.draft === true || data.draft === "true";
            if (state.type === "news") {
              state.author = typeof data.author === "string" ? data.author : "Swansea Esports";
              state.category = typeof data.category === "string" ? data.category : "";
              state.intro = typeof data.intro === "string" ? data.intro : "";
              state.teaser = typeof data.teaser === "string" ? data.teaser : "";
            } else {
              state.startDate = typeof data.startDate === "string" ? data.startDate : "";
              state.endDate = typeof data.endDate === "string" ? data.endDate : "";
              state.location = typeof data.location === "string" ? data.location : "";
              state.game = typeof data.game === "string" ? data.game : "";
              state.link = typeof data.link === "string" ? data.link : "";
              state.description = typeof data.description === "string" ? data.description : "";
              state.organiser = typeof data.organiser === "string" ? data.organiser : "";
            }
            state.image = typeof data.image === "string" ? data.image : "";
            state.thumbnail = typeof data.thumbnail === "string" ? data.thumbnail : "";
            state.blocks = parseBlocks(typeof data.body === "string" ? data.body : "");
            syncTypeFields();
            syncInputs();
            updateHeading();
            updateReadyUI();
            updateSlugHint();
            updatePreviewLink();
            loadViews();
            dirty = false;
            setStatus("Saved");
          } catch (e) {
            setError("Network error — could not load the article.");
          }
        }

        function normalizeDate(v) {
          if (!v) return todayLocal();
          // Accept YYYY-MM-DD or ISO datetimes; always show local time.
          try {
            const d = new Date(v);
            if (Number.isNaN(d.getTime())) return todayLocal();
            const pad = (n) => String(n).padStart(2, "0");
            return (
              d.getFullYear() +
              "-" + pad(d.getMonth() + 1) +
              "-" + pad(d.getDate()) +
              "T" + pad(d.getHours()) +
              ":" + pad(d.getMinutes())
            );
          } catch (e) {
            return todayLocal();
          }
        }

        function updateHeading() {
          const verb = state.mode === "edit" ? "Edit" : "New";
          const noun = state.type === "news" ? "news post" : "event";
          $("editor-heading").textContent = verb + " " + noun;
        }

        function updateSlugHint() {
          $("w-slug-hint").textContent = state.slug ? "/" + state.type + "/" + state.slug : "—";
        }

        function updatePreviewLink() {
          const link = $("editor-preview-link");
          if (state.slug) {
            link.href = `/api/preview?type=${encodeURIComponent(state.type)}&slug=${encodeURIComponent(state.slug)}`;
            link.classList.remove("hidden");
          } else {
            link.classList.add("hidden");
          }
        }

        function updateReadyUI() {
          // Editors cannot flip the ready gate (admin-only).
          const readyBox = $("w-ready");
          readyBox.checked = state.ready;
          if (role !== "admin") {
            readyBox.disabled = true;
            readyBox.title = "Only admins can make an article ready";
            $("w-ready").parentElement.querySelector("span").textContent = "Ready (admin only)";
          } else {
            readyBox.disabled = false;
          }
        }

        async function loadViews() {
          try {
            const res = await fetch(`/api/article-stats?type=${encodeURIComponent(state.type)}&slug=${encodeURIComponent(state.slug)}`);
            if (!res.ok) return;
            const data = await res.json();
            $("editor-views").textContent = `👁 ${data.humanViews} · 🤖 ${data.botViews}`;
            $("editor-views").title = `${data.views} total views (${data.humanViews} human, ${data.botViews} bot)`;
            $("editor-views").classList.remove("hidden");
          } catch (e) {
            /* views unavailable — hide quietly */
          }
        }

        function syncTypeFields() {
          const isNews = state.type === "news";
          // Author and category are news-only; events credit the organiser instead.
          $("w-author-wrap").classList.toggle("hidden", !isNews);
          $("w-category-wrap").classList.toggle("hidden", !isNews);
          $("w-organiser-wrap").classList.toggle("hidden", isNews);
          $("w-startdate-wrap").classList.toggle("hidden", isNews);
          $("w-enddate-wrap").classList.toggle("hidden", isNews);
          $("w-location-wrap").classList.toggle("hidden", isNews);
          $("w-game-wrap").classList.toggle("hidden", isNews);
          $("w-link-wrap").classList.toggle("hidden", isNews);
          $("w-intro-wrap").classList.toggle("hidden", !isNews);
          $("w-teaser-wrap").classList.toggle("hidden", !isNews);
          $("w-desc-wrap").classList.toggle("hidden", isNews);
        }

        function syncInputs() {
          $("w-title").value = state.title;
          $("w-date").value = state.date;
          $("w-author").value = state.author;
          $("w-category").value = state.category;
          $("w-intro").value = state.intro;
          $("w-teaser").value = state.teaser;
          $("w-organiser").value = state.organiser;
          $("w-startdate").value = state.startDate;
          $("w-enddate").value = state.endDate;
          $("w-desc").value = state.description;
          $("w-location").value = state.location;
          $("w-game").value = state.game;
          $("w-link").value = state.link;
          $("w-sponsored").checked = state.sponsored;
          updateImageUI();
          updateThumbnailUI();
          renderBlocks();
        }

        const SWAN_WIDE = "/brand/swan-wide.png";

        function updateImageUI() {
          const preview = $("w-image-preview");
          const status = $("w-image-status");
          if (state.image) {
            preview.src = state.image;
            preview.classList.remove("hidden");
            $("w-image-remove").classList.remove("hidden");
            status.textContent = "";
          } else {
            // Empty intro image falls back to the swan banner.
            preview.src = SWAN_WIDE;
            preview.classList.remove("hidden");
            $("w-image-remove").classList.add("hidden");
            status.textContent = "Defaults to the swan banner.";
          }
        }

        function updateThumbnailUI() {
          const preview = $("w-thumb-preview");
          if (state.thumbnail) {
            preview.src = state.thumbnail;
            preview.classList.remove("hidden");
            $("w-thumb-remove").classList.remove("hidden");
            $("w-thumb-status").textContent = "";
          } else {
            preview.removeAttribute("src");
            preview.classList.add("hidden");
            $("w-thumb-remove").classList.add("hidden");
            $("w-thumb-status").textContent = "No thumbnail — cards will fall back to the intro image or swan banner.";
          }
        }

        // ---- explicit save (no autosave) ---------------------------------------
        function markDirty() {
          dirty = true;
          setStatus("Unsaved changes…");
        }

        async function saveNow() {
          if (!state.slug) return { ok: false, error: "No slug" };
          setStatus("Saving…");
          try {
            const payload = collectPayload();
            const res = await fetch(`${API}?type=${encodeURIComponent(state.type)}&slug=${encodeURIComponent(state.slug)}`, {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
              setError((data && data.error) || "Save failed — try again.");
              setStatus("Save failed");
              return { ok: false, error: (data && data.error) || "Save failed" };
            }
            state.sha = data.sha || state.sha;
            dirty = false;
            setError("");
            setStatus("Saved ✓");
            return { ok: true };
          } catch (e) {
            setStatus("Save failed — offline?");
            return { ok: false, error: "Network error" };
          }
        }

        function collectPayload() {
          // Convert the local datetime-local input to a UTC ISO string so the
          // unpublish gate compares correctly regardless of viewer timezone.
          const dateIso = (() => {
            try {
              const d = new Date(state.date);
              return Number.isNaN(d.getTime()) ? state.date : d.toISOString();
            } catch (e) {
              return state.date;
            }
          })();
          const payload = {
            type: state.type,
            title: state.title.trim(),
            date: dateIso,
            body: serializeBlocks(),
            draft: !state.ready, // ready = live; everything else is a draft
            ready: state.ready,
            sponsored: state.sponsored,
          };
          if (state.type === "news") {
            payload.author = state.author.trim() || "Swansea Esports";
            payload.category = state.category.trim();
            payload.intro = state.intro.trim();
            payload.teaser = state.teaser.trim();
          } else {
            payload.startDate = state.startDate.trim();
            payload.endDate = state.endDate.trim();
            payload.location = state.location.trim();
            payload.game = state.game.trim();
            payload.link = state.link.trim();
            payload.description = state.description.trim();
            payload.organiser = state.organiser.trim();
          }
          // Empty intro image = the swan banner (the site's default hero).
          payload.image = state.image.trim() || SWAN_WIDE;
          if (state.thumbnail.trim()) payload.thumbnail = state.thumbnail.trim();
          return payload;
        }

        // ---- blocks ---------------------------------------------------------------
        const BLOCK_SIZES = ["small", "medium", "large", "full"];

        function serializeBlocks() {
          return state.blocks
            .map((b) => {
              if (b.kind === "text") {
                const text = String(b.text || "").trim();
                if (!text) return "";
                // Wide text blocks are wrapped in a raw-HTML div the article
                // stylesheet expands beyond the prose column.
                return b.wide ? `<div class="wide">\n\n${text}\n\n</div>` : text;
              }
              if (!b.url) return "";
              const alt = b.caption || "";
              const size = BLOCK_SIZES.includes(b.size) ? b.size : "full";
              // Markdown title attribute = display size (omitted for the default).
              return size === "full"
                ? "![" + alt + "](" + b.url + ")"
                : "![" + alt + "](" + b.url + ' "' + size + '")';
            })
            .join("\n\n");
        }

        function parseBlocks(md) {
          const blocks = [];
          let text = [];
          let wide = false; // inside a <div class="wide">…</div> wrapper
          const flushText = () => {
            const t = text.join("\n").trim();
            if (t) blocks.push({ kind: "text", text: t, wide: wide });
            text = [];
            wide = false;
          };
          String(md || "")
            .split("\n")
            .forEach((line) => {
              const trimmed = line.trim();
              const img = /^!\[([^\]]*)\]\(([^)]+?)(?:\s+"([^"]*)")?\)$/.exec(trimmed);
              if (img) {
                flushText();
                const size = BLOCK_SIZES.includes(img[3]) ? img[3] : "full";
                blocks.push({ kind: "image", url: img[2], caption: img[1], size });
                return;
              }
              if (/^<div class="wide">\s*$/.test(trimmed)) {
                flushText();
                wide = true;
                return;
              }
              if (/^<\/div>\s*$/.test(trimmed)) {
                flushText();
                return;
              }
              text.push(line);
            });
          flushText();
          return blocks.length ? blocks : [{ kind: "text", text: "", wide: false }];
        }

        function renderBlocks() {
          const list = $("block-list");
          list.textContent = "";

          state.blocks.forEach((block, i) => {
            const row = document.createElement("div");
            row.className = "rounded-lg border border-white/10 bg-ink p-4";

            const head = document.createElement("div");
            head.className = "flex items-center justify-between gap-3";
            const label = document.createElement("span");
            label.className = "text-xs font-semibold uppercase tracking-wider text-brand";
            label.textContent = block.kind === "text" ? "Text block" : "Image block";
            head.append(label);

            const controls = document.createElement("div");
            controls.className = "flex flex-wrap items-center gap-2";
            if (block.kind === "text") {
              const wideLabel = document.createElement("label");
              wideLabel.className =
                "flex cursor-pointer items-center gap-1.5 rounded border border-white/15 px-2 py-1 text-xs text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite";
              wideLabel.title = "Expand this block beyond the prose column";
              const wideBox = document.createElement("input");
              wideBox.type = "checkbox";
              wideBox.className = "h-3.5 w-3.5 accent-[#e08f20]";
              wideBox.checked = !!block.wide;
              wideBox.addEventListener("change", () => {
                state.blocks[i].wide = wideBox.checked;
                markDirty();
              });
              wideLabel.append(wideBox, document.createTextNode("Wide"));
              controls.append(wideLabel);
            }
            const mkBtn = (txt, cls, onClick) => {
              const b = document.createElement("button");
              b.type = "button";
              b.className =
                "rounded border border-white/15 px-2 py-1 text-xs text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite" +
                (cls ? " " + cls : "");
              b.textContent = txt;
              b.addEventListener("click", onClick);
              return b;
            };
            controls.append(
              mkBtn("↑", "", () => moveBlock(i, -1)),
              mkBtn("↓", "", () => moveBlock(i, 1)),
              mkBtn("Remove", "hover:border-red-400/50 hover:text-red-400", () => removeBlock(i))
            );
            head.append(controls);
            row.append(head);

            if (block.kind === "text") {
              // Formatting toolbar (markdown shortcuts — wraps selection).
              const toolbar = document.createElement("div");
              toolbar.className = "mt-3 flex flex-wrap gap-1";
              const fmt = (label, before, after, placeholder) => {
                const b = document.createElement("button");
                b.type = "button";
                b.title = placeholder || label;
                b.className =
                  "rounded border border-white/15 px-2 py-1 text-xs text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite";
                b.textContent = label;
                b.addEventListener("click", () => {
                  const ta = row.querySelector("textarea");
                  const start = ta.selectionStart;
                  const end = ta.selectionEnd;
                  const sel = ta.value.slice(start, end) || placeholder || "";
                  ta.value = ta.value.slice(0, start) + before + sel + after + ta.value.slice(end);
                  ta.focus();
                  ta.setSelectionRange(start + before.length, start + before.length + sel.length);
                  state.blocks[i].text = ta.value;
                  markDirty();
                });
                return b;
              };
              toolbar.append(
                fmt("B", "**", "**", "bold text"),
                fmt("I", "*", "*", "italic text"),
                fmt("H2", "\n## ", "\n", "Heading"),
                fmt("🔗", "[", "](https://example.com)", "link text"),
                fmt("•", "\n- ", "\n", "List item"),
                fmt("❝", "\n> ", "\n", "Quote"),
              );
              const ta = document.createElement("textarea");
              ta.rows = 4;
              ta.className = "mt-2 w-full resize-y rounded-lg border border-white/10 bg-ink px-3 py-2.5 font-mono text-sm text-offwhite outline-none transition-colors focus:border-brand";
              ta.placeholder = "Write a paragraph or two… (markdown allowed)";
              ta.value = block.text;
              ta.addEventListener("input", () => {
                state.blocks[i].text = ta.value;
                markDirty();
              });
              row.append(toolbar, ta);
            } else {
              if (block.url || block.previewUrl) {
                const img = document.createElement("img");
                img.src = block.previewUrl || block.url;
                img.alt = "";
                // object-contain so the whole image is visible (never cropped).
                img.className = "mt-3 h-28 w-full rounded-lg border border-white/10 bg-black/30 object-contain";
                row.append(img);
              }
              const bar = document.createElement("div");
              bar.className = "mt-3 flex flex-wrap items-center gap-2";
              const pickBtn = document.createElement("button");
              pickBtn.type = "button";
              pickBtn.className =
                "rounded border border-white/15 px-3 py-1.5 text-xs text-offwhite/70 transition-colors hover:border-white/30 hover:text-offwhite";
              pickBtn.textContent = block.url ? "Replace image" : "Choose image";
              pickBtn.addEventListener("click", () => openMediaPicker({ kind: "block", index: i }));
              bar.append(pickBtn);

              const sizeSelect = document.createElement("select");
              sizeSelect.className =
                "rounded border border-white/15 bg-ink px-2 py-1.5 text-xs text-offwhite/70 outline-none transition-colors focus:border-brand";
              sizeSelect.title = "Display size of this image";
              BLOCK_SIZES.forEach((s) => {
                const o = document.createElement("option");
                o.value = s;
                o.textContent = s[0].toUpperCase() + s.slice(1);
                sizeSelect.append(o);
              });
              sizeSelect.value = BLOCK_SIZES.includes(block.size) ? block.size : "full";
              sizeSelect.addEventListener("change", () => {
                state.blocks[i].size = sizeSelect.value;
                markDirty();
              });
              const sizeLabel = document.createElement("span");
              sizeLabel.className = "text-xs text-offwhite/50";
              sizeLabel.textContent = "Size:";
              bar.append(sizeLabel, sizeSelect);
              row.append(bar);

              const cap = document.createElement("input");
              cap.type = "text";
              cap.maxLength = 200;
              cap.placeholder = "Caption (optional)";
              cap.className = "mt-2 w-full rounded-lg border border-white/10 bg-ink px-3 py-2 text-sm text-offwhite outline-none transition-colors focus:border-brand";
              cap.value = block.caption || "";
              cap.addEventListener("input", () => {
                state.blocks[i].caption = cap.value;
                markDirty();
              });
              row.append(cap);
            }

            list.append(row);
          });
        }

        function moveBlock(i, delta) {
          const j = i + delta;
          if (j < 0 || j >= state.blocks.length) return;
          const tmp = state.blocks[i];
          state.blocks[i] = state.blocks[j];
          state.blocks[j] = tmp;
          renderBlocks();
          markDirty();
        }

        function removeBlock(i) {
          if (state.blocks.length > 1) {
            state.blocks.splice(i, 1);
          } else {
            state.blocks[0] = { kind: "text", text: "" };
          }
          renderBlocks();
          markDirty();
        }

        // ---- image upload (WebP conversion) -----------------------------------------
        // Reads the file, converts to WebP via canvas (falls back to the
        // original if WebP is unsupported), then uploads. Returns { url, previewUrl }.
        async function uploadFile(file) {
          let data = await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(new Error("Could not read the file"));
            reader.readAsDataURL(file);
          });
          let contentType = file.type || "image/png";
          let filename = file.name;

          // Convert to WebP client-side (saves ~30-70% vs JPEG/PNG).
          try {
            const webp = await fileToWebP(file);
            if (webp) {
              data = webp.dataUrl;
              contentType = "image/webp";
              filename = filename.replace(/\.[^.]+$/, "") + ".webp";
            }
          } catch (e) {
            /* keep original */
          }

          const res = await fetch("/api/upload", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ filename, data, contentType }),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error((json && json.error) || "Upload failed — try again.");
          return { url: json.url, previewUrl: data };
        }

        function fileToWebP(file) {
          return new Promise((resolve) => {
            const img = new Image();
            img.onload = () => {
              try {
                const canvas = document.createElement("canvas");
                canvas.width = img.naturalWidth;
                canvas.height = img.naturalHeight;
                const ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0);
                canvas.toBlob(
                  (blob) => {
                    if (!blob) return resolve(null);
                    const reader = new FileReader();
                    reader.onload = () => resolve({ dataUrl: reader.result });
                    reader.onerror = () => resolve(null);
                    reader.readAsDataURL(blob);
                  },
                  "image/webp",
                  0.82
                );
              } catch (e) {
                resolve(null);
              }
            };
            img.onerror = () => resolve(null);
            img.src = URL.createObjectURL(file);
          });
        }

        // ---- media picker + thumbnail crop --------------------------------------
        // Uploads a raw data URL (already WebP) straight to /api/upload.
        async function uploadDataUrl(dataUrl, filename) {
          const res = await fetch("/api/upload", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ filename, data: dataUrl, contentType: "image/webp" }),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error((json && json.error) || "Upload failed — try again.");
          return json.url;
        }

        let mediaTarget = null; // { kind: "image" } | { kind: "thumbnail" } | { kind: "block", index }
        let mediaOpener = null; // element to return focus to on close

        async function openMediaPicker(target) {
          mediaTarget = target;
          mediaOpener = document.activeElement;
          $("media-modal").classList.remove("hidden");
          $("media-status").textContent = "Loading images…";
          $("media-grid").textContent = "";
          $("media-empty").classList.add("hidden");
          try {
            const res = await fetch("/api/media");
            const data = await res.json().catch(() => ({}));
            renderMediaGrid(Array.isArray(data.items) ? data.items : []);
          } catch (e) {
            $("media-status").textContent = "Could not load the media library.";
            renderMediaGrid([]);
          }
        }

        function closeMediaPicker() {
          $("media-modal").classList.add("hidden");
          if (mediaOpener && typeof mediaOpener.focus === "function") mediaOpener.focus();
          mediaOpener = null;
          mediaTarget = null;
        }

        function renderMediaGrid(items) {
          const grid = $("media-grid");
          grid.textContent = "";
          $("media-empty").classList.toggle("hidden", items.length > 0);
          $("media-status").textContent = items.length
            ? items.length + (items.length === 1 ? " image" : " images") + " available."
            : "No images yet — upload one to get started.";
          items.forEach((item) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className =
              "group overflow-hidden rounded-lg border border-white/10 bg-ink text-left transition-colors hover:border-brand/60";
            btn.title = item.name;
            btn.setAttribute("aria-label", "Use " + item.name);
            const img = document.createElement("img");
            img.src = item.url;
            img.alt = "";
            img.loading = "lazy";
            img.className = "aspect-video w-full object-cover transition-opacity group-hover:opacity-90";
            const name = document.createElement("span");
            name.className = "block truncate px-2 py-1.5 text-[10px] text-offwhite/50";
            name.textContent = item.name;
            btn.append(img, name);
            btn.addEventListener("click", () => handleMediaPick(item.url));
            grid.append(btn);
          });
          const first = grid.querySelector("button");
          if (first) first.focus();
          else $("media-close").focus();
        }

        function handleMediaPick(url) {
          const target = mediaTarget;
          if (!target) return;
          if (target.kind === "thumbnail") {
            closeMediaPicker();
            openCropUI(url);
            return;
          }
          if (target.kind === "image") {
            state.image = url;
            closeMediaPicker();
            updateImageUI();
          } else if (target.kind === "block") {
            state.blocks[target.index].url = url;
            state.blocks[target.index].previewUrl = null;
            closeMediaPicker();
            renderBlocks();
          }
          markDirty();
          setError("");
        }

        // ---- thumbnail crop ------------------------------------------------------
        const crop = {
          url: "",
          img: null, // the <img> element inside the stage
          naturalW: 0,
          naturalH: 0,
          coverScale: 1, // scale at which the image exactly covers the stage
          zoomMult: 1, // 1 = cover
          panX: 0,
          panY: 0,
          drag: null, // { startX, startY, panX, panY }
          raf: 0,
          opener: null,
        };

        function openCropUI(url) {
          crop.opener = document.activeElement;
          crop.url = url;
          crop.zoomMult = 1;
          crop.panX = 0;
          crop.panY = 0;
          crop.drag = null;
          const img = $("crop-img");
          crop.img = img;
          img.onload = () => {
            crop.naturalW = img.naturalWidth;
            crop.naturalH = img.naturalHeight;
            layoutCrop();
            drawCropPreview();
          };
          img.onerror = () => {
            /* leave the stage empty; the status line below the modal explains the crop */
          };
          img.src = url;
          $("crop-zoom").value = 100;
          $("crop-modal").classList.remove("hidden");
          setTimeout(() => $("crop-apply").focus(), 50);
        }

        function closeCropUI() {
          $("crop-modal").classList.add("hidden");
          if (crop.img) crop.img.onload = null;
          if (crop.opener && typeof crop.opener.focus === "function") crop.opener.focus();
          crop.opener = null;
        }

        function layoutCrop() {
          const stage = $("crop-stage");
          const W = stage.clientWidth;
          const H = stage.clientHeight;
          if (!W || !H || !crop.naturalW || !crop.naturalH) return;
          crop.coverScale = Math.max(W / crop.naturalW, H / crop.naturalH);
          const scale = crop.coverScale * crop.zoomMult;
          const imgW = crop.naturalW * scale;
          const imgH = crop.naturalH * scale;
          const maxPanX = Math.max(0, (imgW - W) / 2);
          const maxPanY = Math.max(0, (imgH - H) / 2);
          crop.panX = Math.max(-maxPanX, Math.min(maxPanX, crop.panX));
          crop.panY = Math.max(-maxPanY, Math.min(maxPanY, crop.panY));
          crop.img.style.width = imgW + "px";
          crop.img.style.height = imgH + "px";
          crop.img.style.left = (W - imgW) / 2 + crop.panX + "px";
          crop.img.style.top = (H - imgH) / 2 + crop.panY + "px";
        }

        function drawCropPreview() {
          const stage = $("crop-stage");
          const canvas = $("crop-preview");
          const ctx = canvas.getContext("2d");
          const W = stage.clientWidth;
          const H = stage.clientHeight;
          if (!W || !H || !crop.naturalW || !crop.naturalH) return;
          const scale = crop.coverScale * crop.zoomMult;
          const imgW = crop.naturalW * scale;
          const imgH = crop.naturalH * scale;
          const left = (W - imgW) / 2 + crop.panX;
          const top = (H - imgH) / 2 + crop.panY;
          // Visible region in natural image coordinates.
          const sx = Math.max(0, -left / scale);
          const sy = Math.max(0, -top / scale);
          const sw = Math.min(crop.naturalW - sx, W / scale);
          const sh = Math.min(crop.naturalH - sy, H / scale);
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          if (sw <= 0 || sh <= 0) return;
          ctx.drawImage(crop.img, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);
        }

        function scheduleCropRender() {
          if (crop.raf) return;
          crop.raf = requestAnimationFrame(() => {
            crop.raf = 0;
            layoutCrop();
            drawCropPreview();
          });
        }

        async function applyCrop() {
          const stage = $("crop-stage");
          const W = stage.clientWidth;
          const H = stage.clientHeight;
          if (!W || !H || !crop.naturalW || !crop.naturalH) return;
          const scale = crop.coverScale * crop.zoomMult;
          const imgW = crop.naturalW * scale;
          const imgH = crop.naturalH * scale;
          const left = (W - imgW) / 2 + crop.panX;
          const top = (H - imgH) / 2 + crop.panY;
          const sx = Math.max(0, -left / scale);
          const sy = Math.max(0, -top / scale);
          const sw = Math.min(crop.naturalW - sx, W / scale);
          const sh = Math.min(crop.naturalH - sy, H / scale);
          if (sw <= 0 || sh <= 0) return;
          const cw = Math.max(1, Math.round(sw));
          const ch = Math.max(1, Math.round(sh));
          const canvas = document.createElement("canvas");
          canvas.width = cw;
          canvas.height = ch;
          canvas.getContext("2d").drawImage(crop.img, sx, sy, sw, sh, 0, 0, cw, ch);
          const dataUrl = await new Promise((resolve) => {
            canvas.toBlob(
              (blob) => {
                if (!blob) return resolve(null);
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = () => resolve(null);
                reader.readAsDataURL(blob);
              },
              "image/webp",
              0.82
            );
          });
          if (!dataUrl) {
            setError("Could not encode the crop — try a smaller image.");
            return;
          }
          const status = $("w-thumb-status");
          status.textContent = "Uploading cropped thumbnail…";
          try {
            const url = await uploadDataUrl(dataUrl, "thumbnail-" + Date.now() + ".webp");
            state.thumbnail = url;
            status.textContent = "Thumbnail appears on cards once the rebuild finishes.";
            closeCropUI();
            updateThumbnailUI();
            markDirty();
            setError("");
          } catch (err) {
            status.textContent = "";
            setError(err.message || "Upload failed — try again.");
          }
        }

        // ---- event wiring -----------------------------------------------------------
        const FIELD_MAP = {
          "w-title": "title",
          "w-date": "date",
          "w-author": "author",
          "w-category": "category",
          "w-intro": "intro",
          "w-teaser": "teaser",
          "w-organiser": "organiser",
          "w-startdate": "startDate",
          "w-enddate": "endDate",
          "w-desc": "description",
          "w-location": "location",
          "w-game": "game",
          "w-link": "link",
        };

        Object.keys(FIELD_MAP).forEach((id) => {
          $(id).addEventListener("input", (e) => {
            state[FIELD_MAP[id]] = e.target.value;
            if (id === "w-title") updateSlugHint();
            markDirty();
          });
        });

        $("w-ready").addEventListener("change", (e) => {
          state.ready = e.target.checked;
          markDirty();
        });

        $("w-sponsored").addEventListener("change", (e) => {
          state.sponsored = e.target.checked;
          markDirty();
        });

        $("w-image-pick").addEventListener("click", () => openMediaPicker({ kind: "image" }));
        $("w-image-remove").addEventListener("click", () => {
          state.image = "";
          updateImageUI();
          markDirty();
        });

        $("w-thumb-pick").addEventListener("click", () => openMediaPicker({ kind: "thumbnail" }));

        $("w-thumb-remove").addEventListener("click", () => {
          state.thumbnail = "";
          updateThumbnailUI();
          markDirty();
        });

        // Media picker modal wiring.
        $("media-close").addEventListener("click", closeMediaPicker);
        $("media-overlay").addEventListener("click", closeMediaPicker);
        $("media-file").addEventListener("change", async (e) => {
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          const status = $("media-status");
          status.textContent = "Uploading…";
          try {
            const { url } = await uploadFile(file);
            status.textContent = "Uploaded — refreshing the library.";
            const res = await fetch("/api/media");
            const data = await res.json().catch(() => ({}));
            renderMediaGrid(Array.isArray(data.items) ? data.items : []);
            // Jump straight to the crop when picking a thumbnail source.
            if (mediaTarget && mediaTarget.kind === "thumbnail") {
              closeMediaPicker();
              openCropUI(url);
            }
          } catch (err) {
            status.textContent = err.message || "Upload failed — try again.";
          }
          e.target.value = "";
        });

        // Crop modal wiring.
        $("crop-close").addEventListener("click", closeCropUI);
        $("crop-overlay").addEventListener("click", closeCropUI);
        $("crop-zoom").addEventListener("input", (e) => {
          crop.zoomMult = Number(e.target.value) / 100;
          scheduleCropRender();
        });
        $("crop-file").addEventListener("change", async (e) => {
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          try {
            const webp = await fileToWebP(file);
            const src = webp ? webp.dataUrl : URL.createObjectURL(file);
            crop.zoomMult = 1;
            crop.panX = 0;
            crop.panY = 0;
            crop.img.src = src;
          } catch (err) {
            setError(err.message || "Could not read that image.");
          }
          e.target.value = "";
        });
        $("crop-apply").addEventListener("click", () => applyCrop());

        // Drag to pan the crop stage.
        const stage = $("crop-stage");
        stage.addEventListener("pointerdown", (e) => {
          if (!crop.naturalW) return;
          crop.drag = { startX: e.clientX, startY: e.clientY, panX: crop.panX, panY: crop.panY };
          stage.setPointerCapture(e.pointerId);
        });
        stage.addEventListener("pointermove", (e) => {
          if (!crop.drag) return;
          crop.panX = crop.drag.panX + (e.clientX - crop.drag.startX);
          crop.panY = crop.drag.panY + (e.clientY - crop.drag.startY);
          scheduleCropRender();
        });
        stage.addEventListener("pointerup", (e) => {
          crop.drag = null;
          try {
            stage.releasePointerCapture(e.pointerId);
          } catch (err) {
            /* already released */
          }
        });
        stage.addEventListener("pointercancel", () => {
          crop.drag = null;
        });

        // Esc closes the topmost modal; focus returns to the opener.
        document.addEventListener("keydown", (e) => {
          if (e.key !== "Escape") return;
          if (!$("crop-modal").classList.contains("hidden")) {
            e.preventDefault();
            closeCropUI();
          } else if (!$("media-modal").classList.contains("hidden")) {
            e.preventDefault();
            closeMediaPicker();
          }
        });

        $("add-text-btn").addEventListener("click", () => {
          state.blocks.push({ kind: "text", text: "" });
          renderBlocks();
          markDirty();
        });

        $("add-image-btn").addEventListener("click", () => {
          state.blocks.push({ kind: "image", url: "", caption: "" });
          renderBlocks();
          markDirty();
        });

        document.querySelectorAll("[data-sort]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const type = btn.dataset.sort;
            const key = btn.dataset.key;
            const cur = listSort[type];
            if (cur.key === key) {
              cur.dir = -cur.dir; // toggle asc/desc on repeat click
            } else {
              cur.key = key;
              cur.dir = -1;
            }
            // Active-state styling.
            document.querySelectorAll(`[data-sort="${type}"]`).forEach((b) => {
              const on = b.dataset.key === cur.key;
              b.classList.toggle("border-brand", on);
              b.classList.toggle("text-brand", on);
            });
            renderList(type);
          });
        });

        // Live search across both lists.
        $("list-search").addEventListener("input", () => {
          renderList("news");
          renderList("events");
        });

        $("new-news-btn").addEventListener("click", () => {
          history.replaceState(null, "", "/admin/new");
          showCreateDialog("news");
        });

        $("new-event-btn").addEventListener("click", () => {
          history.replaceState(null, "", "/admin/new");
          showCreateDialog("events");
        });

        $("create-cancel").addEventListener("click", () => {
          showView("list");
          fetchList();
        });

        $("create-form").addEventListener("submit", async (e) => {
          e.preventDefault();
          const name = $("c-title").value.trim();
          const author = $("c-author").value.trim();
          const err = $("create-error");
          if (!name || !author) {
            err.textContent = "Name and author/organiser are both required.";
            err.classList.remove("hidden");
            return;
          }
          err.classList.add("hidden");
          const btn = $("create-btn");
          btn.disabled = true;
          btn.textContent = "Creating…";
          const ok = await createArticle(createType, name, author);
          btn.disabled = false;
          btn.textContent = "Create draft";
          if (ok) {
            // createArticle already navigated to the editor via loadArticle.
            showView("editor");
          }
        });

        $("btn-save").addEventListener("click", () => saveNow());

        $("btn-duplicate").addEventListener("click", () => duplicateArticle());

        $("btn-publish").addEventListener("click", () => publishNow());

        $("editor-back-link").addEventListener("click", (e) => {
          e.preventDefault();
          if (dirty && !window.confirm("You have unsaved changes. Leave without saving?")) {
            return;
          }
          history.replaceState(null, "", "/admin/new");
          showView("list");
          fetchList();
        });

        $("signout-btn").addEventListener("click", async () => {
          try {
            await fetch("/api/auth/logout", { method: "POST" });
          } catch (e) {
            /* ignore — reload regardless */
          }
          location.reload();
        });

        $("login-form").addEventListener("submit", async (e) => {
          e.preventDefault();
          const btn = $("login-btn");
          const err = $("login-error");
          btn.disabled = true;
          btn.textContent = "Signing in…";
          err.classList.add("hidden");
          try {
            const res = await fetch("/api/auth/login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                email: $("login-email").value.trim(),
                password: $("login-password").value,
              }),
            });
            if (res.ok) {
              location.reload();
              return;
            }
            const data = await res.json().catch(() => ({}));
            err.textContent = (data && data.error) || "Invalid credentials";
            err.classList.remove("hidden");
          } catch (e2) {
            err.textContent = "Network error — try again.";
            err.classList.remove("hidden");
          } finally {
            btn.disabled = false;
            btn.textContent = "Sign in";
          }
        });

        // ---- boot -----------------------------------------------------------------
        (async function init() {
          const params = new URLSearchParams(location.search);
          const editType = params.get("type");
          const editSlug = params.get("slug");
          try {
            const res = await fetch("/api/auth/me");
            if (res.ok) {
              const me = await res.json();
              role = me.role === "editor" ? "editor" : "admin";
              if (editType && editSlug && (editType === "news" || editType === "events")) {
                openEditor(editType, editSlug);
              } else {
                showView("list");
                fetchList();
              }
            } else {
              showView("login");
            }
          } catch (e) {
            showView("login");
          }
        })();
      })();
    </script>
  </body>
</html>

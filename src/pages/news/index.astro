---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getCollection } from "astro:content";
import { site } from "../../site.config";

const posts = (await getCollection("news"))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const feedSocials = site.socials.filter((s) => ["Twitter / X", "Instagram", "Twitch"].includes(s.label));
---

<BaseLayout title="News">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl tracking-wide text-offwhite">News</h1>
    <p class="mt-2 text-offwhite/60">Announcements, results and updates.</p>

    {
      posts.length > 0 ? (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((n) => (
            <NewsCard title={n.data.title} date={n.data.date} excerpt={n.data.excerpt} image={n.data.image} href={`/news/${n.id}`} />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-offwhite/60">No posts yet.</p>
      )
    }
  </section>

  <section class="border-t border-white/10 bg-brand-gradient">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="font-display text-3xl tracking-wide text-offwhite">Follow the community</h2>
      <p class="mt-2 text-offwhite/60">Match-day clips, memes and announcements land on our socials first.</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          feedSocials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="group flex flex-col justify-between rounded-lg border border-white/10 bg-panel p-5 transition-colors hover:border-brand/60">
              <div>
                <span class="font-display text-xl tracking-wide text-offwhite transition-colors group-hover:text-brand">{s.label}</span>
                <p class="mt-1 text-sm text-offwhite/60">@swanseagg</p>
              </div>
              <span class="mt-6 text-sm font-medium text-brand">Follow →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

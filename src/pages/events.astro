---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import { getCollection } from "astro:content";

const now = new Date();
// Live = published (ready && date <= now). Upcoming/past is split by the
// event's startDate (when it actually happens), falling back to date.
const all = (await getCollection("events")).filter((e) => !e.data.draft && e.data.ready && e.data.date <= now);
const starts = (e: { data: { startDate?: Date; date: Date } }) => e.data.startDate || e.data.date;
const upcoming = all
  .filter((e) => starts(e) >= now || (e.data.endDate && e.data.endDate >= now))
  .sort((a, b) => starts(a).getTime() - starts(b).getTime());
const past = all
  .filter((e) => starts(e) < now && !(e.data.endDate && e.data.endDate >= now))
  .sort((a, b) => starts(b).getTime() - starts(a).getTime());
---

<BaseLayout title="Events">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl tracking-wide text-offwhite">Events</h1>
    <p class="mt-2 text-offwhite/60">Tournaments, socials, LANs and watch parties.</p>

    <h2 class="mt-10 font-display text-2xl tracking-wide text-brand">Upcoming</h2>
    {
      upcoming.length > 0 ? (
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((e) => (
            <EventCard title={e.data.title} date={e.data.startDate || e.data.date} endDate={e.data.endDate} location={e.data.location} game={e.data.game} organiser={e.data.organiser} image={e.data.image} thumbnail={e.data.thumbnail} href={`/events/${e.id}`} />
          ))}
        </div>
      ) : (
        <p class="mt-4 text-offwhite/60">Nothing scheduled — join the Discord to hear first.</p>
      )
    }

    <h2 class="mt-12 font-display text-2xl tracking-wide text-brand">Past</h2>
    {
      past.length > 0 ? (
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {past.map((e) => (
            <EventCard title={e.data.title} date={e.data.startDate || e.data.date} endDate={e.data.endDate} location={e.data.location} game={e.data.game} organiser={e.data.organiser} image={e.data.image} thumbnail={e.data.thumbnail} href={`/events/${e.id}`} />
          ))}
        </div>
      ) : (
        <p class="mt-4 text-offwhite/60">No past events yet.</p>
      )
    }
  </section>
</BaseLayout>

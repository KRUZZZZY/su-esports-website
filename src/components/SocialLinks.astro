---
import { site } from "../site.config";
---

<div class="flex flex-wrap gap-2">
  {
    site.socials.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener"
        class="rounded-full border border-line/15 px-3 py-1.5 text-xs font-medium text-offwhite/80 transition-colors hover:border-brand hover:text-brand"
      >
        {s.label}
      </a>
    ))
  }
</div>

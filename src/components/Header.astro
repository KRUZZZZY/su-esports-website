---
import { site } from "../site.config";

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line/25 bg-ink/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label="Swansea Esports — home">
      <img src="/brand/swan-head.png" alt="" width="36" height="36" class="h-9 w-9 rounded-full bg-black" />
      <span class="font-display text-2xl leading-none tracking-widest text-offwhite">
        SWANSEA <span class="text-brand">ESPORTS</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium tracking-wide transition-colors",
              isActive(item.href) ? "text-brand" : "text-offwhite/80 hover:text-offwhite"
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-offwhite transition-colors hover:bg-line/10 hover:text-brand"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="icon-moon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <a
        href={site.discord}
        target="_blank"
        rel="noopener"
        class="rounded bg-brand px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-brand-dark"
      >
        Join Discord
      </a>
    </nav>

    <div class="flex items-center gap-1 md:hidden">
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-offwhite transition-colors hover:bg-line/10 hover:text-brand"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="icon-moon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center rounded px-2 py-1 text-offwhite [&::-webkit-details-marker]:hidden" aria-label="Open menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-lg border border-line/25 bg-panel p-2 shadow-xl">
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "block rounded px-3 py-2 text-sm font-medium",
                  isActive(item.href) ? "text-brand" : "text-offwhite/80 hover:bg-line/5 hover:text-offwhite"
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={site.discord}
            target="_blank"
            rel="noopener"
            class="mt-1 block rounded bg-brand px-3 py-2 text-center text-sm font-semibold text-black hover:bg-brand-dark"
          >
            Join Discord
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Theme toggle: flips data-theme on <html> and persists the choice.
  // Icons + logo adapt via CSS ([data-theme="light"] rules in global.css).
  const toggleButtons = document.querySelectorAll("[data-theme-toggle]");
  toggleButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isLight = document.documentElement.hasAttribute("data-theme");
      if (isLight) {
        document.documentElement.removeAttribute("data-theme");
        localStorage.setItem("theme", "dark");
      } else {
        document.documentElement.setAttribute("data-theme", "light");
        localStorage.setItem("theme", "light");
      }
    });
  });
</script>

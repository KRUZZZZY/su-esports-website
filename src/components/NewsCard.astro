---
interface Props {
  title: string;
  date: Date;
  excerpt?: string;
  image?: string;
  href: string;
}

const { title, date, excerpt, image, href } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<a href={href} class="group flex flex-col overflow-hidden rounded-lg border border-line/25 bg-panel transition-colors hover:border-brand/60">
  {
    image ? (
      <img src={image} alt="" width="640" height="360" class="aspect-video w-full object-cover" />
    ) : (
      <div class="flex aspect-video w-full items-center justify-center bg-brand-gradient">
        <img src="/brand/swan-head.png" alt="" width="64" height="64" class="h-16 w-16 opacity-40" />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <time class="text-xs font-semibold uppercase tracking-wider text-brand">{fmt(date)}</time>
    <h3 class="mt-2 font-display text-xl leading-tight tracking-wide text-offwhite transition-colors group-hover:text-brand">{title}</h3>
    {excerpt && <p class="mt-2 text-sm text-offwhite/60 line-clamp-2">{excerpt}</p>}
  </div>
</a>

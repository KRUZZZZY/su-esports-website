---
interface Props {
  name: string;
  ign?: string;
  game: string;
  role: string;
  photo?: string;
  socials?: string;
}

const { name, ign, game, role, photo, socials } = Astro.props;
const initials = name
  .split(" ")
  .map((p) => p[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<div class="flex items-center gap-4 rounded-lg border border-white/10 bg-panel p-4">
  {
    photo ? (
      <img src={photo} alt={name} width="56" height="56" class="h-14 w-14 rounded-full object-cover" />
    ) : (
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand/15 font-display text-xl text-brand">{initials}</div>
    )
  }
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-semibold text-offwhite">{name}</span>
      {ign && <span class="text-sm text-offwhite/50">“{ign}”</span>}
    </div>
    <div class="text-sm text-offwhite/60">{role} · {game}</div>
  </div>
  {socials && (
    <a href={socials} target="_blank" rel="noopener" class="text-sm font-medium text-brand transition-colors hover:text-brand-dark">
      Profile ↗
    </a>
  )}
</div>

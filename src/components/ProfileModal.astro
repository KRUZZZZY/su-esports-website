---
// Reusable profile popup. Rendered hidden; opened via the delegated
// click/keydown handlers below for any element carrying a `data-profile`
// attribute (JSON: { name, role, ign?, photo?, bio?, socials? }).
---

<div
  id="profile-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="profile-modal-name"
  hidden
  class="fixed inset-0 z-50"
>
  <div id="profile-modal-backdrop" class="absolute inset-0 bg-black/70"></div>

  <div class="absolute left-1/2 top-1/2 w-full max-w-sm -translate-x-1/2 -translate-y-1/2 rounded-xl border border-white/10 bg-panel p-6 shadow-2xl">
    <button
      id="profile-modal-close"
      type="button"
      aria-label="Close profile"
      class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-lg text-offwhite/60 transition-colors hover:bg-white/10 hover:text-offwhite"
    >
      ✕
    </button>

    <div class="flex items-center gap-4 pr-8">
      <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brand/15 font-display text-2xl text-brand">
        <img id="profile-modal-photo" alt="" class="hidden h-16 w-16 rounded-full object-cover" />
        <span id="profile-modal-initials">--</span>
      </div>
      <div class="min-w-0">
        <h3 id="profile-modal-name" class="font-display text-2xl tracking-wide text-offwhite"></h3>
        <p id="profile-modal-role" class="text-sm text-brand"></p>
      </div>
    </div>

    <p id="profile-modal-ign" class="mt-3 hidden text-sm text-offwhite/50"></p>
    <p id="profile-modal-bio" class="mt-3 hidden text-sm leading-relaxed text-offwhite/70"></p>
    <a
      id="profile-modal-social"
      href="#"
      target="_blank"
      rel="noopener"
      class="mt-4 hidden text-sm font-medium text-brand transition-colors hover:text-brand-dark"
    >
      Profile ↗
    </a>
  </div>
</div>

<script>
  interface ProfileData {
    name?: string;
    role?: string;
    ign?: string;
    photo?: string;
    bio?: string;
    socials?: string;
  }

  const modal = document.getElementById("profile-modal") as HTMLDivElement;
  const backdrop = document.getElementById("profile-modal-backdrop") as HTMLDivElement;
  const closeBtn = document.getElementById("profile-modal-close") as HTMLButtonElement;
  const photoImg = document.getElementById("profile-modal-photo") as HTMLImageElement;
  const initialsEl = document.getElementById("profile-modal-initials") as HTMLSpanElement;
  const nameEl = document.getElementById("profile-modal-name") as HTMLHeadingElement;
  const roleEl = document.getElementById("profile-modal-role") as HTMLParagraphElement;
  const ignEl = document.getElementById("profile-modal-ign") as HTMLParagraphElement;
  const bioEl = document.getElementById("profile-modal-bio") as HTMLParagraphElement;
  const socialEl = document.getElementById("profile-modal-social") as HTMLAnchorElement;

  let lastTrigger: HTMLElement | null = null;
  let prevOverflow = "";

  function initials(name: string): string {
    return name
      .split(" ")
      .map((p) => p[0])
      .join("")
      .slice(0, 2)
      .toUpperCase();
  }

  function openProfile(trigger: HTMLElement) {
    let data: ProfileData;
    try {
      data = JSON.parse(trigger.dataset.profile || "{}") as ProfileData;
    } catch {
      return;
    }
    lastTrigger = trigger;

    if (data.photo) {
      photoImg.src = data.photo;
      photoImg.alt = data.name || "Profile photo";
      photoImg.classList.remove("hidden");
      initialsEl.classList.add("hidden");
    } else {
      photoImg.classList.add("hidden");
      initialsEl.textContent = initials(data.name || "?");
      initialsEl.classList.remove("hidden");
    }

    nameEl.textContent = data.name || "";
    roleEl.textContent = data.role || "";

    if (data.ign) {
      ignEl.textContent = `“${data.ign}”`;
      ignEl.classList.remove("hidden");
    } else {
      ignEl.textContent = "";
      ignEl.classList.add("hidden");
    }

    if (data.bio) {
      bioEl.textContent = data.bio;
      bioEl.classList.remove("hidden");
    } else {
      bioEl.textContent = "";
      bioEl.classList.add("hidden");
    }

    if (data.socials) {
      socialEl.href = data.socials;
      socialEl.classList.remove("hidden");
    } else {
      socialEl.removeAttribute("href");
      socialEl.classList.add("hidden");
    }

    modal.hidden = false;
    prevOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  }

  function closeProfile() {
    if (modal.hidden) return;
    modal.hidden = true;
    document.body.style.overflow = prevOverflow;
    if (lastTrigger) lastTrigger.focus();
  }

  // Delegated open: any [data-profile] element. Inner links (e.g. the card's
  // "Profile ↗") are left alone so they navigate instead of opening the modal.
  document.addEventListener("click", (e: MouseEvent) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest<HTMLElement>("[data-profile]");
    if (!trigger) return;
    if (target.closest("a")) return;
    openProfile(trigger);
  });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && !modal.hidden) {
      closeProfile();
      return;
    }
    // Enter/Space on role="button" triggers (real <button>s fire click natively).
    if (e.key !== "Enter" && e.key !== " ") return;
    const target = e.target;
    if (!(target instanceof Element)) return;
    if (target.closest("a")) return;
    const trigger = target.closest<HTMLElement>('[role="button"][data-profile]');
    if (!trigger) return;
    e.preventDefault();
    openProfile(trigger);
  });

  closeBtn.addEventListener("click", closeProfile);
  backdrop.addEventListener("click", closeProfile);
</script>
